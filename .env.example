# Copied to .env, which the CLI reads (nothing overrides a variable already exported).

# Chat model for body-fill, transcription and metadata: any OpenAI-compatible
# endpoint. Gemini's is shown; a LiteLLM gateway works the same way for the CLI
# and is what the live_llm tests need.
LITELLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LITELLM_API_KEY=
LITELLM_MODEL=gemini-3.7-flash
# Optional: retried when the model refuses a page on a content filter (Gemini's
# RECITATION on published law). Unset, a refused page is recorded as unreadable.
# LITELLM_CONTENT_FILTER_FALLBACK_MODEL=

# Database tests and migrations. Matches docker-compose.yaml.
POSTGRES_URL=postgresql://codify:codify@localhost:5432/codify

# Optional: a second OCR engine for scanned pages (Azure AI Foundry, Mistral OCR).
# Unset, every page is read once by the chat model's vision route.
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=

# Optional: Langfuse tracing.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=
