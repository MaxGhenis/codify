    "uri_patterns": {
      "constitution": "/akn/ma/act/constitution/2011/constitution"
    },
    "date_calendar": "gregorian",
    "notes": [
      "Law number segment is the YY-NNN portion of the official Loi n° YY-NNN identifier (hyphens retained).",
      "Dahir number segment drops the leading '1-' category prefix (e.g., Dahir n° 1-11-91 → URI segment '11-91').",
      "Decree number segment drops the leading '2-' category prefix.",
      "Hijri date stored as <FRBRalias showAs='hijriDate'> in document metadata.",
      "Bilingual documents: Arabic expression /ara@{date}, French expression /fra@{date}. Both are authoritative originals; Arabic is constitutionally prevailing.",
      "Inserted articles: bis/ter/quater suffix convention (e.g., art_4bis, art_4ter) or hyphenated decimal (art_4-1)."
    ]
  },
  "numbering": {
    "insertion_style": "bis_ter",
    "note": "Two-digit year in law numbers refers to legislative session year, not calendar year of promulgation. Disambiguation: if number portion >99, it is the sequential number not the year."
  },
