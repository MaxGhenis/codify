  "document_classes": {
    "act": {
      "label": "Ustawa",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "article",
      "hierarchy": [
        {
          "local_term": "Księga",
          "akn_element": "book",
          "level": "higher",
          "bluebell_keyword": "BOOK",
          "numbering": "ordinal_pl",
          "note": "Used only in major codes (Civil Code, Criminal Code, etc.)"
        },
        {
          "local_term": "Tytuł",
          "akn_element": "title",
          "level": "higher",
          "bluebell_keyword": "TITLE",
          "numbering": "roman"
        },
        {
          "local_term": "Dział",
          "akn_element": "part",
          "level": "higher",
          "bluebell_keyword": "PART",
          "numbering": "roman",
          "note": "No dedicated AKN element for dział; mapped to part"
        },
        {
          "local_term": "Rozdział",
          "akn_element": "chapter",
          "level": "higher",
          "bluebell_keyword": "CHAPTER",
          "numbering": "arabic_continuous"
        },
        {
          "local_term": "Artykuł",
          "akn_element": "article",
          "level": "basic",
          "bluebell_keyword": "ARTICLE",
          "numbering": "arabic_continuous",
          "note": "Continuous across entire act, never restarts within higher divisions"
        },
        {
          "local_term": "Ustęp",
          "akn_element": "paragraph",
          "level": "subdivision",
          "bluebell_keyword": "SUBSECTION",
          "numbering": "arabic_period",
          "note": "Numbered with period: 1. 2. 3. — mapped to paragraph in AKN"
        },
        {
          "local_term": "Punkt",
          "akn_element": "point",
          "level": "subdivision",
          "bluebell_keyword": "POINT",
          "numbering": "arabic_rparen"
        },
        {
          "local_term": "Litera",
          "akn_element": "indent",
          "level": "subdivision",
          "bluebell_keyword": "INDENT",
          "numbering": "alpha_lower_rparen",
          "note": "Excludes Polish-specific letters; see ambiguity 3 in profile"
        },
        {
          "local_term": "Tiret",
          "akn_element": "indent",
          "level": "subdivision",
          "bluebell_keyword": "INDENT",
          "numbering": "none",
          "note": "Unnumbered dash (–) enumeration"
        }
      ],
      "hcontainers": [
        {
          "local_term": "Oddział",
          "name": "oddział",
          "level": "higher",
          "note": "Sub-chapter grouping below Rozdział, above Artykuł; see ambiguity 2 in profile"
        }
      ]
    },
