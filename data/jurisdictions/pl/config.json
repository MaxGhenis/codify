  "frbr": {
    "country_code": "pl",
    "uri_patterns": {
      "constitution": "/akn/pl/act/constitution/1997/constitution"
    },
    "date_calendar": "gregorian",
    "notes": [
      "Post-2012: year + sequential poz only (e.g., Dz.U. 2023 poz. 641 → /akn/pl/act/2023/641).",
      "Pre-2012: year + Nr + poz format (e.g., Dz.U. 1964 Nr 16 poz. 93). URI uses sequential poz if available from ISAP, else Nr-poz as fallback.",
      "Consolidated texts (tekst jednolity): canonical URI is the original enactment year/poz. Consolidation position stored as FRBRalias.",
      "Bills: use Sejm druk sejmowy (printed matter number) before enactment. Update URI when poz assigned.",
      "Monitor Polski instruments published under /akn/pl/act/mp/{year}/{poz}."
    ]
