      "hierarchy": [
        {
          "local_term": "Dio",
          "akn_element": "part",
          "level": "higher",
          "bluebell_keyword": "PART",
          "numbering": "ordinal_word_croatian",
          "note": "DIO PRVI, DIO DRUGI — ordinal words normalised to arabic for eId (part_1, part_2)"
        },
        {
          "local_term": "Glava",
          "akn_element": "chapter",
          "level": "higher",
          "bluebell_keyword": "CHAPTER",
          "numbering": "roman",
          "note": "GLAVA I, GLAVA II — Roman numerals normalised to arabic (chap_1, chap_2)"
        },
        {
          "local_term": "Odjeljak",
          "akn_element": "section",
          "level": "higher",
          "bluebell_keyword": "SECTION",
          "numbering": "arabic",
          "note": "Higher division only — NOT the basic unit. Odjeljak 1., Odjeljak 2."
        },
        {
          "local_term": "Odsjek",
          "akn_element": "subsection",
          "level": "higher",
          "bluebell_keyword": "SUBSECTION",
          "numbering": "arabic",
          "note": "Rare — used only in very large codes within an Odjeljak"
        },
        {
          "local_term": "Članak",
          "akn_element": "article",
          "level": "basic",
          "bluebell_keyword": "ARTICLE",
          "numbering": "arabic_continuous",
          "note": "BASIC UNIT. Continuous Arabic numbering throughout entire act regardless of higher divisions. Never resets."
        },
        {
          "local_term": "Stavak",
          "akn_element": "paragraph",
          "level": "subdivision",
          "bluebell_keyword": "PARAGRAPH",
          "numbering": "arabic_parenthesized",
          "note": "(1), (2), (3). Only numbered when two or more stavci exist in an article."
        },
        {
          "local_term": "Točka",
          "akn_element": "point",
          "level": "subdivision",
          "bluebell_keyword": "POINT",
          "numbering": "arabic_stop_or_alpha_lower_parenthesized",
          "note": "1., 2., 3. or a), b), c). At least two required per Uniform Rules."
        },
        {
          "local_term": "Podtočka",
          "akn_element": "indent",
          "level": "subdivision",
          "bluebell_keyword": "INDENT",
          "numbering": "alpha_lower_or_roman_lower",
          "note": "Sub-items within a točka. Rare."
        }
      ],
      "hcontainers": [
        {
          "local_term": "Podstavak",
          "name": "podstavak",
          "note": "Unnumbered indented sub-paragraph within a stavak; maps to alinea in AKN. Used in older legislation."
        },
        {
          "local_term": "Prijelazne i završne odredbe",
          "name": "transitional-final",
          "note": "Transitional and Final Provisions block, typically final Glava or Odjeljak"
