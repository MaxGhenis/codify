    "act": {
      "label": "Lög",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "article",
      "hierarchy": [
        {
          "local_term": "Hluti",
          "akn_element": "part",
          "level": "higher",
          "bluebell_keyword": "PART",
          "numbering": "roman_or_arabic"
        },
        {
          "local_term": "Kafli",
          "akn_element": "chapter",
          "level": "higher",
          "bluebell_keyword": "CHAPTER",
          "numbering": "arabic"
        },
        {
          "local_term": "Grein (§)",
          "akn_element": "article",
          "level": "basic",
          "bluebell_keyword": "ARTICLE",
          "numbering": "arabic_continuous"
        },
        {
          "local_term": "Málsgrein",
          "akn_element": "paragraph",
          "level": "subdivision",
          "bluebell_keyword": "PARAGRAPH",
          "numbering": "arabic_sequential_assigned",
          "note": "Unnumbered prose paragraph within a grein. First málsgrein is direct article content; subsequent ones become PARAGRAPH 2, 3, etc."
        },
        {
          "local_term": "Stafliður",
          "akn_element": "point",
          "level": "subdivision",
          "bluebell_keyword": "POINT",
          "numbering": "alpha_lower_closing_paren"
        }
      ],
      "hcontainers": [],
      "note": "Icelandic § (grein) is the basic statutory unit, mapping to AKN article and consistent with DK/SE/NO/DE civil law convention. § numbers are continuous across all kaflar. Most acts have no hluti — short acts may have no kaflar either, just a flat sequence of greinar."
    },
    "reglugjord": {
      "label": "Reglugerð",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "article",
      "hierarchy": [
        {
          "local_term": "Kafli",
          "akn_element": "chapter",
          "level": "higher",
          "bluebell_keyword": "CHAPTER",
          "numbering": "arabic"
        },
        {
          "local_term": "Grein (§)",
          "akn_element": "article",
          "level": "basic",
          "bluebell_keyword": "ARTICLE",
          "numbering": "arabic_continuous"
        },
        {
          "local_term": "Málsgrein",
          "akn_element": "paragraph",
          "level": "subdivision",
          "bluebell_keyword": "PARAGRAPH",
          "numbering": "arabic_sequential_assigned"
        },
        {
          "local_term": "Stafliður",
          "akn_element": "point",
          "level": "subdivision",
          "bluebell_keyword": "POINT",
          "numbering": "alpha_lower_closing_paren"
        }
      ],
      "hcontainers": [],
      "note": "Executive regulation issued by minister under statutory authority (heimild). Numbered in the Stjórnartíðindi series with its own sequential number per year. Separate FRBR work. URI uses rgj/ subtype."
    },
    "stjornarskra": {
      "label": "Stjórnarskrá lýðveldisins Íslands",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "article",
      "hierarchy": [
        {
          "local_term": "Grein (§)",
          "akn_element": "article",
          "level": "basic",
          "bluebell_keyword": "ARTICLE",
          "numbering": "arabic_continuous"
        },
        {
          "local_term": "Málsgrein",
          "akn_element": "paragraph",
          "level": "subdivision",
          "bluebell_keyword": "PARAGRAPH",
          "numbering": "arabic_sequential_assigned"
        }
      ],
      "hcontainers": [],
      "note": "The 1944 Constitution. §§ 1–80, no higher divisions. Amended by constitutional acts (stjórnarskrárlög) requiring two Althingi votes with an intervening general election. The 1944 constitution replaced the 1920 constitution (itself a revision of the 1874 Danish-era constitution). A new constitution was drafted 2011–2013 but not enacted."
    },
    "thingsalyktun": {
      "label": "Þingsályktun",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "article",
      "hierarchy": [
        {
          "local_term": "Grein (§)",
          "akn_element": "article",
          "level": "basic",
          "bluebell_keyword": "ARTICLE",
          "numbering": "arabic_continuous"
        }
      ],
      "hcontainers": [],
      "note": "Parliamentary resolution (Þingsályktun). Non-binding formal expression of will of Althingi — used for government authorisations, ratification of international agreements, and parliamentary directions. Numbered separately from lög."
    },
    "tilskipun": {
      "label": "Tilskipun",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "article",
      "hierarchy": [
        {
          "local_term": "Grein (§)",
          "akn_element": "article",
          "level": "basic",
          "bluebell_keyword": "ARTICLE",
          "numbering": "arabic_continuous"
        },
        {
          "local_term": "Málsgrein",
          "akn_element": "paragraph",
          "level": "subdivision",
          "bluebell_keyword": "PARAGRAPH",
          "numbering": "arabic_sequential_assigned"
        }
      ],
      "hcontainers": [],
      "note": "Historical royal ordinance from the Danish-crown era (pre-1944). Some tilskipanir remain in force in the Lagasafn. Enacted by the Danish crown, now treated as Icelandic law. URI uses tsk/ subtype. Enacting authority in metadata indicates Danish-era origin."
    }
  },
