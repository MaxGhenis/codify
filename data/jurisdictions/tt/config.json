    "insertion_style_verified": true,
    "insertion_example": "Firearms Amendment Act 2021 inserts sections 6A, 6B, 6C (after s.6) and 9B (after s.9A)"
  },
  "enacting_formulae": [
    {
      "text": "ENACTED by the Parliament of Trinidad and Tobago as follows:",
      "position": "preamble",
      "era": "post-republic",
      "from": "1976-08-01",
      "verified": true,
      "observed_in": [
        "Act No. 2 of 2000",
        "Act No. 3 of 2010",
        "Act No. 23 of 2019",
        "Act No. 7 of 2021"
      ],
      "note": "Gazette renders first word in small-caps. The em-dash variant ('as follows:—') also observed (Act No. 2 of 2000). Both forms are equivalent.",
      "document_class": "act"
    },
    {
      "text": "BE IT ENACTED by the Queen's Most Excellent Majesty, by and with the advice and consent of the Senate and House of Representatives of Trinidad and Tobago, and by the authority of the same, as follows:—",
      "position": "preamble",
      "era": "independence-pre-republic",
      "from": "1962-08-31",
      "to": "1976-08-01",
      "verified": false,
      "note": "Standard Commonwealth Independence form assumed.",
      "document_class": "act"
    }
  ],
  "amendments": {
