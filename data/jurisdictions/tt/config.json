    "act": {
      "label": "Act of Parliament",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "section",
      "hierarchy": [
        {
          "local_term": "Part",
          "akn_element": "part",
          "level": "higher",
          "bluebell_keyword": "PART",
          "numbering": "roman"
        },
        {
          "local_term": "Section",
          "akn_element": "section",
          "level": "basic",
          "bluebell_keyword": "SECTION",
          "numbering": "arabic_continuous"
        },
        {
          "local_term": "Subsection",
          "akn_element": "subsection",
          "level": "subdivision",
          "bluebell_keyword": "SUBSECTION",
          "numbering": "arabic_parenthesized"
        },
        {
          "local_term": "Paragraph",
          "akn_element": "paragraph",
          "level": "subdivision",
          "bluebell_keyword": "PARAGRAPH",
          "numbering": "alpha_lower_parenthesized"
        },
        {
          "local_term": "Subparagraph",
          "akn_element": "subparagraph",
          "level": "subdivision",
          "bluebell_keyword": "SUBPARAGRAPH",
          "numbering": "roman_lower_parenthesized"
        },
        {
          "local_term": "Sub-subparagraph",
          "akn_element": "point",
          "level": "subdivision",
          "bluebell_keyword": "POINT",
          "numbering": "alpha_upper_parenthesized",
          "note": "Uppercase letters (A), (B) — observed in Schedule amendments in Finance Act 2019. Uncommon in act bodies."
        }
      ],
      "hcontainers": [
        {
          "local_term": "Division",
          "name": "division",
          "level": "higher",
          "position": "between_part_and_section",
          "numbering": "arabic",
          "bluebell_note": "No Bluebell keyword. Requires post-processing to inject hcontainer wrapper. Observed in Companies Act (Chap. 81:01) and Trade Marks Regulations 2020."
        }
      ]
    },
    "si": {
      "label": "Subsidiary Legislation (Legal Notice)",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "section",
      "hierarchy": [
        {
          "local_term": "Part",
          "akn_element": "part",
          "level": "higher",
          "bluebell_keyword": "PART",
          "numbering": "roman"
        },
        {
          "local_term": "Regulation",
          "akn_element": "section",
          "level": "basic",
          "bluebell_keyword": "SECTION",
          "numbering": "arabic_continuous"
        },
        {
          "local_term": "Subsection",
          "akn_element": "subsection",
          "level": "subdivision",
          "bluebell_keyword": "SUBSECTION",
          "numbering": "arabic_parenthesized"
        },
        {
          "local_term": "Paragraph",
          "akn_element": "paragraph",
          "level": "subdivision",
          "bluebell_keyword": "PARAGRAPH",
          "numbering": "alpha_lower_parenthesized"
        }
      ],
      "hcontainers": [
        {
          "local_term": "Division",
          "name": "division",
          "level": "higher",
          "position": "between_part_and_section",
          "numbering": "arabic",
          "bluebell_note": "Observed in Trade Marks Regulations 2020 (PART II contains DIVISION 1 through DIVISION 7). Requires post-processing injection."
        }
      ],
      "note": "SIs (Legal Notices, cited as L.N. NN/YYYY) use 'regulation' as the local basic unit term but map to AKN section. REGULATION is not a valid Bluebell keyword. Divisions within Parts are common in complex SIs."
    },
    "constitution": {
      "label": "Constitution",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "section",
      "hierarchy": [
        {
          "local_term": "Chapter",
          "akn_element": "chapter",
          "level": "higher",
          "bluebell_keyword": "CHAPTER",
          "numbering": "arabic",
          "note": "Constitution uses Arabic numerals: CHAPTER 1, CHAPTER 2 (not Roman). Numbered 1–9."
        },
        {
          "local_term": "Part",
          "akn_element": "part",
          "level": "higher",
          "bluebell_keyword": "PART",
          "numbering": "roman",
          "note": "Parts appear inside Chapters. Roman numeral: PART I, PART II."
        },
        {
          "local_term": "Section",
          "akn_element": "section",
          "level": "basic",
          "bluebell_keyword": "SECTION",
          "numbering": "arabic_continuous"
        },
        {
          "local_term": "Subsection",
          "akn_element": "subsection",
          "level": "subdivision",
          "bluebell_keyword": "SUBSECTION",
          "numbering": "arabic_parenthesized"
        },
        {
          "local_term": "Paragraph",
          "akn_element": "paragraph",
          "level": "subdivision",
          "bluebell_keyword": "PARAGRAPH",
          "numbering": "alpha_lower_parenthesized"
        }
      ],
      "hcontainers": [],
      "note": "Constitution (Chap. 1:01, Act 4 of 1976) uses a three-level hierarchy above section: CHAPTER (Arabic) > PART (Roman within Chapter) > SECTION. A PRELIMINARY section (ss. 1–3) precedes the first Chapter. This three-level nesting is unique to the Constitution — ordinary legislation uses only PART > SECTION."
    }
  },
  "default_document_class": "act",
  "frbr": {
    "country_code": "tt",
    "uri_patterns": {
      "act": "/akn/tt/act/{year}/{number}",
      "si": "/akn/tt/act/si/{year}/{number}",
      "bill": "/akn/tt/bill/{year}/{number}",
      "constitution": "/akn/tt/act/constitution/1976/constitution"
    },
    "date_calendar": "gregorian",
    "notes": "When only a Chapter number (Chap. NN:NN) is known, use 'chap{NN}-{NN}' as both year and number segments (e.g., Chap. 16:01 → chap16-01). Record Chapter number as FRBRalias. Update URI when original act number and year are recovered from laws.gov.tt amendment history. Act numbers appear on gazette PDF title pages as 'Act No. N of YYYY' and are reliably machine-readable."
  },
  "numbering": {
    "act_citation": "Act No. {number} of {year}",
    "act_citation_alt": "Chap. {chapter}",
    "si_citation": "L.N. {number}/{year}",
