  "default_document_class": "act",
  "frbr": {
    "country_code": "gh",
    "uri_patterns": {
      "act": "/akn/gh/act/{year}/{number}",
      "li": "/akn/gh/act/li/{year}/{number}",
      "ci": "/akn/gh/act/ci/{year}/{number}",
      "ei": "/akn/gh/act/ei/{year}/{number}",
      "bill": "/akn/gh/bill/{year}/{number}",
      "constitution": "/akn/gh/act/{year}/constitution"
    },
    "notes": "Acts use a single continuous sequential numbering run since First Republic (1960). Act 720 is the 720th act since 1960, not the 720th act of 2006. LIs use L.I. NNNN sequential numbers; CIs use C.I. NN sequential numbers; EIs use E.I. NN sequential numbers. GhaLII uses /akn/gh/act/li/, /akn/gh/act/ci/ subtypes confirmed.",
    "date_calendar": "gregorian"
  },
  "numbering": {
    "act_citation": "Act {number}",
    "act_citation_alt": "Act {number} of {year}",
    "insertion_style": "alphanumeric",
    "note": "Act numbers are continuous across all years since 1960 — the year in the citation is the enactment year, not the number's year. E.g., 'Whistleblower Act, 2006 (Act 720)' = the 720th act since 1960, enacted in 2006."
  },
  "enacting_formulae": [
    {
      "text": "BE IT ENACTED by Parliament as follows:",
