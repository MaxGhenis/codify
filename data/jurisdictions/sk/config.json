          "akn_element": "part",
          "level": "higher",
          "bluebell_keyword": "PART",
          "numbering": "ordinal_word_slovak"
        },
        {
          "local_term": "§ (Paragraf)",
          "akn_element": "article",
          "level": "basic",
          "bluebell_keyword": "ARTICLE",
          "numbering": "arabic_continuous"
        },
        {
          "local_term": "Odsek",
          "akn_element": "paragraph",
          "level": "subdivision",
          "bluebell_keyword": "PARAGRAPH",
          "numbering": "arabic_parenthesized"
        },
        {
          "local_term": "Písmeno",
          "akn_element": "point",
          "level": "subdivision",
          "bluebell_keyword": "POINT",
          "numbering": "alpha_lower_closing_paren"
        },
        {
          "local_term": "Bod",
          "akn_element": "indent",
          "level": "subdivision",
          "bluebell_keyword": "INDENT",
          "numbering": "arabic_period"
        }
      ],
      "hcontainers": [],
      "note": "Government regulations use identical § structure to ordinary zákony. Enabling formula references the empowering statute."
    },
    "vyhlaska": {
      "label": "Vyhláška (Ministerial Decree)",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "article",
      "hierarchy": [
        {
          "local_term": "§ (Paragraf)",
          "akn_element": "article",
          "level": "basic",
          "bluebell_keyword": "ARTICLE",
          "numbering": "arabic_continuous"
        },
        {
          "local_term": "Odsek",
          "akn_element": "paragraph",
          "level": "subdivision",
          "bluebell_keyword": "PARAGRAPH",
          "numbering": "arabic_parenthesized"
        },
        {
          "local_term": "Písmeno",
          "akn_element": "point",
          "level": "subdivision",
          "bluebell_keyword": "POINT",
          "numbering": "alpha_lower_closing_paren"
        },
        {
          "local_term": "Bod",
          "akn_element": "indent",
          "level": "subdivision",
          "bluebell_keyword": "INDENT",
          "numbering": "arabic_period"
        }
      ],
      "hcontainers": [],
      "note": "Ministerial decrees use same § structure. Higher divisions are rarer; simple vyhlášky may have only §."
    }
  },
  "default_document_class": "act",
  "frbr": {
    "country_code": "sk",
    "uri_patterns": {
      "act": "/akn/sk/act/{year}/{number}",
      "ustavny_zakon": "/akn/sk/act/ustavn/{year}/{number}",
