  "document_classes": {
    "act": {
      "label": "Zákon (Act of Parliament)",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "article",
      "hierarchy": [
        {
          "local_term": "Časť (Part)",
          "akn_element": "part",
          "level": "higher",
          "bluebell_keyword": "PART",
          "numbering": "ordinal_word_slovak",
          "note": "PRVÁ ČASŤ, DRUHÁ ČASŤ — Slovak ordinal words, normalised to Arabic integer for eId"
        },
        {
          "local_term": "Hlava (Chapter/Head)",
          "akn_element": "chapter",
          "level": "higher",
          "bluebell_keyword": "CHAPTER",
          "numbering": "ordinal_word_slovak_or_roman",
          "note": "PRVÁ HLAVA or Hlava I — normalised to Arabic integer for eId"
        },
        {
          "local_term": "Diel (Division)",
          "akn_element": "title",
          "level": "higher",
          "bluebell_keyword": "TITLE",
          "numbering": "ordinal_word_slovak",
          "note": "Prvý diel, Druhý diel — used within Hlavy in major codes"
        },
        {
          "local_term": "Oddiel (Section/grouping)",
          "akn_element": "section",
          "level": "higher",
          "bluebell_keyword": "DIVISION",
          "numbering": "ordinal_word_slovak",
          "note": "Higher-division grouper above § — NOT the basic unit. Prvý oddiel, Druhý oddiel."
        },
        {
          "local_term": "§ (Paragraf)",
          "akn_element": "article",
          "level": "basic",
          "bluebell_keyword": "ARTICLE",
          "numbering": "arabic_continuous"
        },
        {
          "local_term": "Odsek (Subsection)",
          "akn_element": "paragraph",
          "level": "subdivision",
          "bluebell_keyword": "PARAGRAPH",
          "numbering": "arabic_parenthesized"
        },
        {
          "local_term": "Písmeno (Letter)",
          "akn_element": "point",
          "level": "subdivision",
          "bluebell_keyword": "POINT",
          "numbering": "alpha_lower_closing_paren",
          "note": "a), b), c)... — Slovak alphabet; ch, dz, dž are typically skipped in legal numbering sequences"
        },
        {
          "local_term": "Bod (Point)",
          "akn_element": "indent",
          "level": "subdivision",
          "bluebell_keyword": "INDENT",
          "numbering": "arabic_period",
          "note": "1., 2., 3. — sub-lists within písmená"
        }
      ],
      "hcontainers": [
        {
          "local_term": "Čl. I / Čl. II (amending article in novelizácia)",
          "name": "amendingArticle",
          "description": "In amendment acts (novelizácie), Čl. I, Čl. II label which target statute is being amended. Structural groupers within an otherwise §-based act. Distinct from Čl. (článok) in constitutional acts.",
          "bluebell_proxy": "PART",
          "requires_postprocessing": true
        }
      ],
      "note": "Slovak § (paragraf) maps to AKN article, following civil law convention identical to Czech §, German §, Austrian §. Higher divisions (Časť > Hlava > Diel > Oddiel) are groupers above the § basic unit. All four levels are optional — simple acts may have only §."
    },
    "ustavny_zakon": {
      "label": "Ústavný zákon (Constitutional Act)",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "article",
      "hierarchy": [
        {
          "local_term": "Hlava (Chapter)",
          "akn_element": "chapter",
          "level": "higher",
          "bluebell_keyword": "CHAPTER",
          "numbering": "ordinal_word_slovak",
          "note": "Constitution has 9 Hlavy. Slovak ordinal words normalised to Arabic for eId."
        },
        {
          "local_term": "Oddiel (Section)",
          "akn_element": "section",
          "level": "higher",
          "bluebell_keyword": "DIVISION",
          "numbering": "ordinal_word_slovak",
          "note": "Sections within Hlavy of the Constitution. e.g., Prvý oddiel, Druhý oddiel."
        },
        {
          "local_term": "Čl. / Článok (Article)",
          "akn_element": "article",
          "level": "basic",
          "bluebell_keyword": "ARTICLE",
          "numbering": "arabic_continuous",
          "note": "Constitutional acts use Čl. (článok) as basic unit, not § (paragraf). Constitution has 156 articles."
        },
        {
          "local_term": "Odsek",
          "akn_element": "paragraph",
          "level": "subdivision",
          "bluebell_keyword": "PARAGRAPH",
          "numbering": "arabic_parenthesized"
        },
        {
          "local_term": "Písmeno",
          "akn_element": "point",
          "level": "subdivision",
          "bluebell_keyword": "POINT",
          "numbering": "alpha_lower_closing_paren"
        }
      ],
      "hcontainers": [],
      "note": "Constitutional acts use Čl. (článok) as basic unit. Same ARTICLE Bluebell keyword as §. Constitution 460/1992 Zb. has 9 Hlavy and 156 Čl."
    },
    "nariadenie": {
      "label": "Nariadenie vlády (Government Regulation)",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "article",
      "hierarchy": [
        {
