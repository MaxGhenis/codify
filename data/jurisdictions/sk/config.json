    },
    "date_calendar": "gregorian",
    "note": "Number = sequential Z.z. number within calendar year (no leading zeros). Year = calendar year of Zbierka zákonov publication. Pre-1993 Czechoslovak-era laws cited as Zb. use the same pattern with the original year and number, under /akn/sk/. The Z.z. sequential series is shared across all document types (statutes, regulations, decrees)."
  },
  "numbering": {
    "act_citation": "zákon č. {number}/{year} Z.z.",
