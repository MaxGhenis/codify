  "default_document_class": "nomos",
  "frbr": {
    "country_code": "gr",
    "uri_patterns": {
      "nomos": "/akn/gr/act/{year}/{number}",
      "presidential_decree": "/akn/gr/act/pd/{year}/{number}",
      "legislative_act_pnp": "/akn/gr/act/pnp/{year}/{number}",
      "constitution": "/akn/gr/act/constitution/1975/syntagma",
      "civil_code": "/akn/gr/act/1940/civil-code",
      "penal_code": "/akn/gr/act/1950/penal-code"
    },
    "date_calendar": "gregorian",
    "notes": [
      "Law number is sequential integer assigned at enactment. Format: {number}/{year} in Greek citation, maps to /akn/gr/act/{year}/{number} in FRBR URI.",
      "Presidential Decrees (ΠΔ) use subtype 'pd'.",
      "Legislative Acts (ΠΝΠ) issued by executive under Art. 44 Constitution use subtype 'pnp'.",
      "Codes pre-date the number/year system; use descriptive slugs."
    ]
  },
  "numbering": {
    "act_citation": "Ν. {number}/{year}",
    "act_citation_alt": "νόμος {number}/{year}",
    "insertion_style": "greek_letter_suffix",
    "insertion_example": "Άρθρο 5Α, Άρθρο 5Β",
    "note": "Inserted articles append a Greek capital letter (Α, Β, Γ); normalise to ASCII Latin capital for eId (5A, 5B, 5C)."
  },
