          "akn_element": "paragraph",
          "level": "subdivision",
          "bluebell_keyword": "PARAGRAPH",
          "numbering": "arabic",
          "note": "Older codes may use Roman numerals; normalise to Arabic for eId"
        },
        {
          "local_term": "Εδάφιο / Περίπτωση (Sub-paragraph)",
          "akn_element": "subparagraph",
          "level": "subdivision",
          "bluebell_keyword": "SUBPARAGRAPH",
          "numbering": "greek_lower_letter",
          "note": "α), β), γ) — normalise to a, b, c for eId"
        },
        {
          "local_term": "Σημείο (Point)",
          "akn_element": "point",
          "level": "subdivision",
          "bluebell_keyword": "POINT",
