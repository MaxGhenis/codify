        {
          "local_term": "Κεφάλαιο (Chapter)",
          "akn_element": "chapter",
          "level": "higher",
          "bluebell_keyword": "CHAPTER",
          "numbering": "greek_capital_letter",
          "note": "Κεφάλαιο Α΄, Β΄, Γ΄ — normalise to Arabic for eId"
        },
        {
          "local_term": "Τμήμα (Section/Division)",
          "akn_element": "section",
          "level": "higher",
          "bluebell_keyword": "DIVISION",
          "numbering": "greek_capital_letter",
