          "akn_element": "book",
          "level": "higher",
          "bluebell_keyword": "BOOK",
          "numbering": "greek_ordinal_to_arabic",
          "note": "Used in codes only (Civil Code 5 Books). Not used in ordinary Nomoi."
        },
        {
          "local_term": "Μέρος (Part)",
          "akn_element": "part",
          "level": "higher",
          "bluebell_keyword": "PART",
          "numbering": "greek_ordinal_word"
