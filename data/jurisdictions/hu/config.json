{
  "code": "hu",
  "name": "Hungary",
  "type": "national",
  "tradition": [
    "civil_law"
  ],
  "calendar": "gregorian",
  "languages": [
    "hun"
  ],
  "authoritative_language": "hun",
  "document_classes": {
    "act": {
      "label": "Act of the National Assembly",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "article",
      "hierarchy": [
        {
          "local_term": "Könyv",
          "akn_element": "book",
          "level": "higher",
          "bluebell_keyword": "BOOK",
          "numbering": "ordinal_word_hu",
          "note": "Used in comprehensive codes only (e.g. Civil Code). Sections use Book:Section prefix notation (1:1. §)."
        },
        {
          "local_term": "Rész",
          "akn_element": "part",
          "level": "higher",
          "bluebell_keyword": "PART",
          "numbering": "ordinal_word_hu",
          "note": "ELSŐ RÉSZ, MÁSODIK RÉSZ etc. Used in large codes and some complex acts."
        },
        {
          "local_term": "Fejezet",
          "akn_element": "chapter",
          "level": "higher",
          "bluebell_keyword": "CHAPTER",
          "numbering": "roman",
          "note": "I. fejezet, II. fejezet. Primary grouping in most acts."
        },
        {
          "local_term": "Alcím",
          "akn_element": "subtitle",
          "level": "higher",
          "bluebell_keyword": "SUBTITLE",
          "numbering": "arabic",
          "note": "Subtitle below fejezet. No Bluebell keyword — requires post-processing to wrap sections in <hcontainer name=\"alcim\">."
        },
        {
          "local_term": "Szakasz",
          "akn_element": "article",
          "level": "basic",
          "bluebell_keyword": "ARTICLE",
          "numbering": "arabic_continuous",
          "note": "The § (section sign) unit. Continuous throughout act. Cited as '15. §'. Basic citable provision."
        },
        {
          "local_term": "Bekezdés",
          "akn_element": "subsection",
          "level": "subdivision",
          "bluebell_keyword": "SUBSECTION",
          "numbering": "arabic_parenthesized",
          "note": "Omitted when section has single unnumbered paragraph. Cited as '(1)', '(2)'."
        },
        {
          "local_term": "Pont",
          "akn_element": "paragraph",
          "level": "subdivision",
          "bluebell_keyword": "PARAGRAPH",
          "numbering": "alpha_lower_closeparen",
          "note": "Lowercase letter + closing paren: a), b), c). Cited as 'a) pont'."
        },
        {
          "local_term": "Alpont",
          "akn_element": "subparagraph",
          "level": "subdivision",
          "bluebell_keyword": "SUBPARAGRAPH",
          "numbering": "double_alpha_lower_closeparen",
          "note": "Double-letter + closing paren: aa), ab), ba). First letter echoes parent pont. Cited as 'aa) alpont'. Hungary-specific convention."
        }
      ],
      "hcontainers": [
        {
          "name": "alcim",
          "local_term": "Alcím",
          "note": "Subtitle grouping element. Numbered (1., 2.) with a short heading. Post-processing required to insert from Bluebell output."
        }
      ]
    },
    "rendelet": {
      "label": "Government Decree",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "article",
      "hierarchy": [
        {
          "local_term": "Fejezet",
          "akn_element": "chapter",
          "level": "higher",
          "bluebell_keyword": "CHAPTER",
          "numbering": "roman"
        },
        {
          "local_term": "Szakasz",
          "akn_element": "article",
          "level": "basic",
          "bluebell_keyword": "ARTICLE",
          "numbering": "arabic_continuous"
        },
        {
          "local_term": "Bekezdés",
          "akn_element": "subsection",
          "level": "subdivision",
          "bluebell_keyword": "SUBSECTION",
          "numbering": "arabic_parenthesized"
        },
        {
          "local_term": "Pont",
          "akn_element": "paragraph",
          "level": "subdivision",
          "bluebell_keyword": "PARAGRAPH",
          "numbering": "alpha_lower_closeparen"
        },
        {
          "local_term": "Alpont",
          "akn_element": "subparagraph",
          "level": "subdivision",
          "bluebell_keyword": "SUBPARAGRAPH",
          "numbering": "double_alpha_lower_closeparen"
        }
      ],
      "hcontainers": [],
      "note": "Government decrees (kormányrendelet) and ministerial decrees (miniszteri rendelet) share this structure. Enabling clause in preamble cites parent act authority."
    },
    "alaptorvenye": {
      "label": "Fundamental Law",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "article",
      "hierarchy": [
        {
          "local_term": "Cikk",
          "akn_element": "article",
          "level": "basic",
          "bluebell_keyword": "ARTICLE",
          "numbering": "capital_letter_parenthesized",
          "note": "Foundation section articles: (A), (B)...(U). Thematic sections use Arabic-numbered articles."
        }
      ],
      "hcontainers": [],
      "note": "Fundamental Law uses Cikk (Article) not Szakasz (Section) as basic unit. Requires separate structuring prompt variant: structure_hu_alaptorvenye.txt. Do not use SECTION keyword."
    }
  },
