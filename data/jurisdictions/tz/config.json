    {
      "text": "ENACTED by the Parliament of the United Republic of Tanzania.",
      "position": "preamble",
      "era": "post-independence",
      "from": "1961-12-09",
      "document_class": "act"
    },
    {
      "text": "BE IT ENACTED by the Governor of Tanganyika, with the advice and consent of the Legislative Council thereof, as follows:",
