      "era": "colonial-ordinance",
      "to": "1961-12-09",
      "document_class": "ordinance"
    },
    {
      "text": "[Minister/Authority], in exercise of the powers conferred by section [N] of the [Parent Act], hereby makes the following Regulations:",
