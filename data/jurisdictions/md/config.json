  "document_classes": {
    "lege": {
      "label": "Lege (Parliamentary Act)",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "article",
      "hierarchy": [
        {
          "local_term": "Cartea",
          "akn_element": "book",
          "level": "higher",
          "bluebell_keyword": "BOOK",
          "numbering": "roman_ordinal",
          "note": "Used in major codes only (Civil Code, Fiscal Code). E.g., 'Cartea întâi', 'Cartea a doua'."
        },
        {
          "local_term": "Partea",
          "akn_element": "part",
          "level": "higher",
          "bluebell_keyword": "PART",
          "numbering": "roman_ordinal",
          "note": "Used in codes alongside or instead of Books. E.g., 'Partea I', 'Partea a II-a'."
        },
        {
          "local_term": "Titlul",
          "akn_element": "title",
          "level": "higher",
          "bluebell_keyword": "TITLE",
          "numbering": "roman",
          "note": "Standard in codes and complex statutes. E.g., 'Titlul I – Dispoziţii generale'."
        },
        {
          "local_term": "Capitolul",
          "akn_element": "chapter",
          "level": "higher",
          "bluebell_keyword": "CHAPTER",
          "numbering": "roman",
          "note": "Most common grouping in ordinary legislation. E.g., 'Capitolul I'."
        },
        {
          "local_term": "Secțiunea",
          "akn_element": "section",
          "level": "higher",
          "bluebell_keyword": "DIVISION",
          "numbering": "arabic_ordinal",
          "note": "CRITICAL: Secțiunea is a higher grouping ABOVE articles, NOT the basic unit. Use DIVISION keyword to avoid confusion with Anglophone section-as-basic-unit. Verify with Bluebell parser. Ordinal style: Secțiunea 1, Secțiunea a 2-a."
        },
        {
          "local_term": "Articolul",
          "akn_element": "article",
          "level": "basic",
          "bluebell_keyword": "ARTICLE",
          "numbering": "arabic_continuous",
          "note": "Basic unit. Numbered continuously throughout the entire act regardless of higher divisions above."
        },
        {
          "local_term": "Alineatul",
          "akn_element": "paragraph",
          "level": "subdivision",
          "bluebell_keyword": "PARAGRAPH",
          "numbering": "arabic_parenthesized",
          "note": "Subdivision (1), (2), (3). Cited as alin.(1)."
        },
        {
          "local_term": "Litera",
          "akn_element": "point",
          "level": "subdivision",
          "bluebell_keyword": "POINT",
          "numbering": "alpha_lower_closing_paren",
          "note": "Subdivision a), b), c). Cited as lit.a)."
        },
        {
          "local_term": "Punctul",
          "akn_element": "indent",
          "level": "subdivision",
          "bluebell_keyword": "INDENT",
          "numbering": "arabic_fullstop",
          "note": "Subdivision 1., 2., 3. Sub-division of litere."
        }
      ],
      "hcontainers": [
        {
          "local_term": "Liniuța (dash item)",
          "name": "liniuta",
          "note": "Dash-introduced items, last resort when other structural elements are exhausted (per Law 100/2017). Cannot be reliably cross-referenced. Pipeline should flag for review."
        }
      ]
    },
    "hg": {
      "label": "Hotărâre de Guvern (Government Decision)",
