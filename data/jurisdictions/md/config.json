          "numbering": "arabic_continuous"
        },
        {
          "local_term": "Alineatul",
          "akn_element": "paragraph",
          "level": "subdivision",
          "bluebell_keyword": "PARAGRAPH",
          "numbering": "arabic_parenthesized"
        },
        {
          "local_term": "Litera",
          "akn_element": "point",
          "level": "subdivision",
          "bluebell_keyword": "POINT",
          "numbering": "alpha_lower_closing_paren"
        }
      ],
      "hcontainers": [],
      "note": "Government decision implementing laws. Functional equivalent of statutory instruments. Typically shorter; chapters optional. May include Anexe (annexes)."
    },
    "og": {
      "label": "Ordonanță de Guvern (Government Ordinance)",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "article",
      "hierarchy": [
        {
          "local_term": "Capitolul",
          "akn_element": "chapter",
          "level": "higher",
          "bluebell_keyword": "CHAPTER",
          "numbering": "roman"
        },
        {
          "local_term": "Articolul",
          "akn_element": "article",
          "level": "basic",
          "bluebell_keyword": "ARTICLE",
          "numbering": "arabic_continuous"
        },
        {
          "local_term": "Alineatul",
          "akn_element": "paragraph",
          "level": "subdivision",
          "bluebell_keyword": "PARAGRAPH",
          "numbering": "arabic_parenthesized"
        },
        {
          "local_term": "Litera",
          "akn_element": "point",
          "level": "subdivision",
          "bluebell_keyword": "POINT",
          "numbering": "alpha_lower_closing_paren"
        }
      ],
      "hcontainers": [],
      "note": "Government ordinance enacted under parliamentary delegation (Art. 106² Constitution). Structure mirrors HG. Enacting body TLC must be Guvernul, not Parlamentul."
    },
    "constitution": {
      "label": "Constituția Republicii Moldova",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "article",
      "hierarchy": [
        {
          "local_term": "Titlul",
          "akn_element": "title",
          "level": "higher",
          "bluebell_keyword": "TITLE",
          "numbering": "roman"
        },
        {
          "local_term": "Capitolul",
          "akn_element": "chapter",
          "level": "higher",
          "bluebell_keyword": "CHAPTER",
          "numbering": "roman"
        },
        {
          "local_term": "Secțiunea",
          "akn_element": "section",
          "level": "higher",
          "bluebell_keyword": "DIVISION",
          "numbering": "arabic_ordinal"
        },
        {
          "local_term": "Articolul",
          "akn_element": "article",
          "level": "basic",
          "bluebell_keyword": "ARTICLE",
          "numbering": "arabic_continuous",
          "note": "Articles numbered continuously Art. 1–142 in current Constitution."
        }
      ],
      "hcontainers": [],
      "note": "Constitution uses Title/Chapter/Section above articles. Some chapters have Sections (Secțiunea); most go directly Title > Chapter > Article."
    }
  },
