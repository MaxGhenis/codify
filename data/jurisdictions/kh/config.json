  "enacting_formulae": [
    {
      "label": "Preah Reach Kram (current, post-1993)",
      "position": "preamble",
      "era": "post-constitution",
      "from": "1993-09-24",
      "structure": "header_block + royal_style + having_seen_clauses + promulgate_clause + parliamentary_adoption_recital",
      "text": "PREAH REACH KRAM No. NS/RKM/[MMYY]/[NNN]\n\nWe, [Royal style of the King],\n\nHaving seen the Constitution of the Kingdom of Cambodia;\nHaving seen the Royal Kram No. NS/RKM/0801/14 dated 28 January 2008 on the promulgation of the Law on the Organization and Functioning of the Council of Ministers;\nHaving seen [relevant prior legislation];\nHaving proposed by [the Prime Minister];\n\nPromulgate:\n\nThe Law on [Subject] passed by the National Assembly on [date] in the [ordinal] plenary session of the [ordinal] legislature and reviewed and approved by the Senate in accordance with the form and spirit of the law without revision on [date] during the [ordinal] plenary session of the [ordinal] legislature, the content of which is as follows:",
      "document_class": "act"
    }
  ],
  "amendments": {
