      "executive_order": "/akn/us/doc/executive-order/{year}/{number}"
    },
    "date_calendar": "gregorian",
    "notes": "Congress number (not calendar year) is used as first path segment for Public Laws and Bills. Pre-1958 laws without Congress-number format should use /akn/us/act/stat/{volume}/{page}."
  },
  "numbering": {
    "act_citation": "Pub.L. {congress}-{number}",
    "act_citation_alt": "{volume} Stat. {page}",
