      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "article",
      "hierarchy": [
        {
          "local_term": "Título",
          "akn_element": "title",
          "level": "higher",
          "bluebell_keyword": "TITLE",
          "numbering": "ordinal_word_spanish"
        },
        {
          "local_term": "Capítulo",
          "akn_element": "chapter",
          "level": "higher",
          "bluebell_keyword": "CHAPTER",
          "numbering": "roman_upper"
        },
        {
          "local_term": "Sección",
          "akn_element": "section",
          "level": "higher",
          "bluebell_keyword": "SUBDIVISION",
          "numbering": "roman_upper",
          "note": "Higher division above artículo; use SUBDIVISION as Bluebell proxy. See ambiguity #2 in profile."
        },
        {
          "local_term": "Artículo",
          "akn_element": "article",
          "level": "basic",
          "bluebell_keyword": "ARTICLE",
          "numbering": "arabic_continuous",
          "note": "Constitutional articles 1–9 use ordinal suffix (1o.) in source; eId always uses Arabic art_1 through art_9."
        },
        {
          "local_term": "Fracción",
          "akn_element": "paragraph",
          "level": "subdivision",
          "bluebell_keyword": "PARAGRAPH",
          "numbering": "roman_upper_to_arabic_eid"
        },
        {
          "local_term": "Inciso",
          "akn_element": "point",
          "level": "subdivision",
          "bluebell_keyword": "POINT",
          "numbering": "alpha_lower"
        },
        {
          "local_term": "Párrafo",
          "akn_element": "alinea",
          "level": "subdivision",
          "bluebell_keyword": null,
          "numbering": "ordinal_position",
          "note": "Unnumbered prose paragraphs. Cited ordinally. Bluebell treats as body content; post-processing needed for alinea wrapping."
        }
      ],
      "hcontainers": [
        {
          "local_term": "Artículo Transitorio",
          "name": "transitorios",
          "note": "Transitional provisions. Numbered artículos within a wrapper hcontainer. Appear at end of every instrument. Post-processing required after Bluebell parse."
        },
        {
          "local_term": "Apartado",
          "name": "apartado",
          "note": "Sub-article compartment (Apartado A, Apartado B). Used in Constitution Arts 2 and 123 and some codes. May contain fracciones."
        }
      ]
    },
