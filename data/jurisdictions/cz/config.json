{
  "code": "cz",
  "name": "Czech Republic",
  "type": "national",
  "tradition": [
    "civil_law"
  ],
  "calendar": "gregorian",
  "languages": [
    "ces"
  ],
  "authoritative_language": "ces",
  "document_classes": {
    "act": {
      "label": "Zákon (Act of Parliament)",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "article",
      "hierarchy": [
        {
          "local_term": "Část (Part)",
          "akn_element": "part",
          "level": "higher",
          "bluebell_keyword": "PART",
          "numbering": "ordinal_word_czech",
          "note": "ČÁST PRVNÍ, ČÁST DRUHÁ — ordinal words in Czech, normalised to Arabic integer for eId"
        },
        {
          "local_term": "Hlava (Chapter/Head)",
          "akn_element": "chapter",
          "level": "higher",
          "bluebell_keyword": "CHAPTER",
          "numbering": "roman"
        },
        {
          "local_term": "Díl (Division)",
          "akn_element": "title",
          "level": "higher",
          "bluebell_keyword": "TITLE",
          "numbering": "arabic"
        },
        {
          "local_term": "Oddíl (Section/grouping)",
          "akn_element": "section",
          "level": "higher",
          "bluebell_keyword": "DIVISION",
          "numbering": "arabic",
          "note": "Used as higher-division grouper above §, not as basic unit"
        },
        {
          "local_term": "Pododdíl (Sub-section/grouping)",
          "akn_element": "subsection",
          "level": "higher",
          "bluebell_keyword": "SUBDIVISION",
          "numbering": "arabic",
          "note": "Very rare; used only in the most extensive acts"
        },
        {
          "local_term": "§ (Paragraf)",
          "akn_element": "article",
          "level": "basic",
          "bluebell_keyword": "ARTICLE",
          "numbering": "arabic_continuous"
        },
        {
          "local_term": "Odstavec (Subsection)",
          "akn_element": "paragraph",
          "level": "subdivision",
          "bluebell_keyword": "PARAGRAPH",
          "numbering": "arabic_parenthesized"
        },
        {
          "local_term": "Písmeno (Letter)",
          "akn_element": "point",
          "level": "subdivision",
          "bluebell_keyword": "POINT",
          "numbering": "alpha_lower_closing_paren",
          "note": "a), b), c)... — Czech alphabet; ch) follows h) in Czech but is typically skipped in legal numbering"
        },
        {
          "local_term": "Bod (Point)",
          "akn_element": "indent",
          "level": "subdivision",
          "bluebell_keyword": "INDENT",
          "numbering": "arabic_period",
          "note": "1., 2., 3. — sub-lists within písmena"
        }
      ],
      "hcontainers": [
        {
          "local_term": "Čl. I / Čl. II (amending article in novelizace)",
          "name": "amendingArticle",
          "description": "In amendment acts (novelizace), Čl. I, Čl. II label which target statute is being amended. These are structural groupers within an otherwise §-based act.",
          "bluebell_proxy": "PART",
          "requires_postprocessing": true
        }
      ],
      "note": "Czech § (paragraf) maps to AKN article, following civil law convention (same as German §). Higher divisions (Část > Hlava > Díl > Oddíl) are groupers above the § basic unit."
    },
    "ustavni_zakon": {
      "label": "Ústavní zákon (Constitutional Act)",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "article",
      "hierarchy": [
        {
          "local_term": "Hlava (Chapter)",
          "akn_element": "chapter",
          "level": "higher",
          "bluebell_keyword": "CHAPTER",
          "numbering": "roman",
          "note": "Constitution has 8 Hlavy (Chapters). Roman numerals normalised to Arabic for eId."
        },
        {
          "local_term": "Čl. / Článek (Article)",
          "akn_element": "article",
          "level": "basic",
          "bluebell_keyword": "ARTICLE",
          "numbering": "arabic_continuous",
          "note": "Constitutional acts use Čl. (článek) as basic unit, not § (paragraf)"
        },
        {
          "local_term": "Odstavec",
          "akn_element": "paragraph",
          "level": "subdivision",
          "bluebell_keyword": "PARAGRAPH",
          "numbering": "arabic_parenthesized"
        },
        {
          "local_term": "Písmeno",
          "akn_element": "point",
          "level": "subdivision",
          "bluebell_keyword": "POINT",
          "numbering": "alpha_lower_closing_paren"
        }
      ],
      "hcontainers": [],
      "note": "Constitutional acts use Čl. (článek) as basic unit, same Bluebell ARTICLE keyword. Constitution 1/1993 Sb. has 8 Hlavy and 113 Čl."
    },
    "narizeni": {
      "label": "Nařízení vlády (Government Regulation)",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "article",
      "hierarchy": [
        {
          "local_term": "Část (Part)",
          "akn_element": "part",
          "level": "higher",
          "bluebell_keyword": "PART",
          "numbering": "ordinal_word_czech"
        },
        {
          "local_term": "§ (Paragraf)",
          "akn_element": "article",
          "level": "basic",
          "bluebell_keyword": "ARTICLE",
          "numbering": "arabic_continuous"
        },
        {
          "local_term": "Odstavec",
          "akn_element": "paragraph",
          "level": "subdivision",
          "bluebell_keyword": "PARAGRAPH",
          "numbering": "arabic_parenthesized"
        },
        {
          "local_term": "Písmeno",
          "akn_element": "point",
          "level": "subdivision",
          "bluebell_keyword": "POINT",
          "numbering": "alpha_lower_closing_paren"
        },
        {
          "local_term": "Bod",
          "akn_element": "indent",
          "level": "subdivision",
          "bluebell_keyword": "INDENT",
          "numbering": "arabic_period"
        }
      ],
      "hcontainers": [],
      "note": "Government regulations use identical § structure to ordinary zákony. Enabling formula references the empowering statute."
    },
    "vyhlaska": {
      "label": "Vyhláška (Ministerial Decree)",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "article",
      "hierarchy": [
        {
          "local_term": "§ (Paragraf)",
          "akn_element": "article",
          "level": "basic",
          "bluebell_keyword": "ARTICLE",
          "numbering": "arabic_continuous"
        },
        {
          "local_term": "Odstavec",
          "akn_element": "paragraph",
          "level": "subdivision",
          "bluebell_keyword": "PARAGRAPH",
          "numbering": "arabic_parenthesized"
        },
        {
          "local_term": "Písmeno",
          "akn_element": "point",
          "level": "subdivision",
          "bluebell_keyword": "POINT",
          "numbering": "alpha_lower_closing_paren"
        },
        {
          "local_term": "Bod",
          "akn_element": "indent",
          "level": "subdivision",
          "bluebell_keyword": "INDENT",
          "numbering": "arabic_period"
        }
      ],
      "hcontainers": [],
      "note": "Ministerial decrees (vyhlášky) use same § structure. May be simpler than nařízení; higher divisions are rarer."
    }
  },
