        {
          "local_term": "Titre",
          "akn_element": "title",
          "level": "higher",
          "bluebell_keyword": "TITLE",
          "numbering": "arabic_with_premier",
          "note": "Most common top-level division; 'TITRE PREMIER' for first"
        },
        {
          "local_term": "Chapitre",
          "akn_element": "chapter",
          "level": "higher",
          "bluebell_keyword": "CHAPTER",
          "numbering": "arabic_with_premier",
          "note": "'CHAPITRE PREMIER' for first"
