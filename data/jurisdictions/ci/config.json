      "bluebell_compatible": true,
      "basic_unit": "article",
      "hierarchy": [
        {
          "local_term": "Livre",
          "akn_element": "book",
          "level": "higher",
          "bluebell_keyword": "BOOK",
          "numbering": "arabic_continuous",
          "note": "Used in major codes only (Code civil, etc.)"
        },
        {
          "local_term": "Titre",
          "akn_element": "title",
          "level": "higher",
          "bluebell_keyword": "TITLE",
          "numbering": "arabic_with_premier",
          "note": "Most common top-level division; 'TITRE PREMIER' for first"
        },
        {
          "local_term": "Chapitre",
          "akn_element": "chapter",
          "level": "higher",
          "bluebell_keyword": "CHAPTER",
          "numbering": "arabic_with_premier",
          "note": "'CHAPITRE PREMIER' for first"
        },
        {
          "local_term": "Section",
          "akn_element": "section",
          "level": "higher",
          "bluebell_keyword": "SECTION",
          "numbering": "arabic_with_premiere",
          "note": "Higher-division grouping ABOVE articles; NOT the basic unit"
        },
        {
          "local_term": "Sous-section",
          "akn_element": "subsection",
          "level": "higher",
          "bluebell_keyword": "SUBSECTION",
          "numbering": "arabic_continuous",
          "note": "Rare; used in large codes only"
        },
        {
          "local_term": "Paragraphe",
          "akn_element": "subpart",
          "level": "higher",
          "bluebell_keyword": "SUBPART",
          "numbering": "arabic_continuous",
          "note": "Structural grouper above articles within a Chapitre; 'paragraphe' in number field per Laws.Africa style guide; post-process to <hcontainer name='paragraphe'>"
        },
        {
          "local_term": "Article",
          "akn_element": "article",
          "level": "basic",
          "bluebell_keyword": "ARTICLE",
          "numbering": "arabic_with_premier",
          "note": "Basic unit; 'Article premier' for first, 'Article 2' onwards. eId normalises to art_1, art_2, etc."
        },
        {
          "local_term": "Alinéa",
          "akn_element": "alinea",
          "level": "subdivision",
          "bluebell_keyword": null,
          "numbering": "implicit",
          "note": "Unnumbered paragraph breaks within an article; implicit in Bluebell body text"
        },
        {
          "local_term": "Point (1°, 2°)",
          "akn_element": "point",
          "level": "subdivision",
          "bluebell_keyword": "POINT",
          "numbering": "arabic_degree",
          "note": "Enumerated items using 1°, 2°, 3° style"
        },
        {
          "local_term": "Lettre (a), b))",
          "akn_element": "point",
          "level": "subdivision",
          "bluebell_keyword": "POINT",
          "numbering": "alpha_lower",
          "note": "Enumerated items using a), b), c) style; maps to same <point> element"
        },
        {
          "local_term": "Tiret (—)",
          "akn_element": "indent",
          "level": "subdivision",
          "bluebell_keyword": "INDENT",
          "numbering": "implicit",
          "note": "Dashed list items"
        }
      ],
      "hcontainers": [
        {
          "name": "paragraphe",
          "description": "Structural Paragraphe grouping multiple articles within a Chapitre; bluebell workaround: SUBPART",
