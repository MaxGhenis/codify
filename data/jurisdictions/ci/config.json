        {
          "local_term": "Sous-section",
          "akn_element": "subsection",
          "level": "higher",
          "bluebell_keyword": "SUBSECTION",
          "numbering": "arabic_continuous",
          "note": "Rare; used in large codes only"
        },
        {
          "local_term": "Paragraphe",
          "akn_element": "hcontainer",
          "level": "higher",
          "bluebell_keyword": "SUBPART",
          "numbering": "arabic_continuous",
          "note": "Structural grouper above articles within a Chapitre; 'paragraphe' in number field per Laws.Africa style guide; post-process to <hcontainer name='paragraphe'>"
        },
        {
          "local_term": "Article",
          "akn_element": "article",
          "level": "basic",
          "bluebell_keyword": "ARTICLE",
          "numbering": "arabic_with_premier",
          "note": "Basic unit; 'Article premier' for first, 'Article 2' onwards. eId normalises to art_1, art_2, etc."
        },
        {
          "local_term": "Alinéa",
          "akn_element": "alinea",
          "level": "subdivision",
          "bluebell_keyword": null,
