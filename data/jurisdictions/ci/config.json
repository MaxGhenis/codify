  "structuring": {
    "prompt_additions": "Côte d'Ivoire uses civil law French hierarchy: BOOK (rare) > TITLE > CHAPTER > SECTION (higher grouping) > ARTICLE (basic unit). ARTICLE is the fundamental citable provision, not SECTION. 'Article premier' for the first article. All headings in French. 'TITRE PREMIER', 'CHAPITRE PREMIER', 'ART premier' for first elements. Alinéas are implicit paragraph breaks within ARTICLE blocks. Internal enumeration uses 1°, 2°, 3° or a), b), c) styles."
  },
  "supranational_memberships": [
    {
      "body": "ohada",
      "direct_effect": "override",
      "superseded_subjects": [
        "company_law",
        "general_commercial_law",
        "insolvency",
        "securities_and_guarantees",
        "arbitration",
        "accounting",
        "cooperative_companies",
        "transport_goods_by_road",
        "commercial_leases"
      ],
      "note": "CCJA (OHADA supreme court) is headquartered in Abidjan. OHADA Uniform Acts are directly applicable and mandatory; they supersede conflicting domestic commercial law. Do not present domestic provisions in these subject areas as current law without referencing OHADA."
    },
    {
      "body": "uemoa",
      "direct_effect": "direct",
      "direct_effect_note": "Regulations only (Art. 43 UEMOA Treaty). Directives require transposition into domestic law.",
