  "authoritative_language": "kaz",
  "document_classes": {
    "zakon": {
      "label": "Zakon Respubliki Kazakhstan (Law of the Republic of Kazakhstan)",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "article",
      "hierarchy": [
        {
          "local_term": "Razdel",
          "akn_element": "part",
          "level": "higher",
          "bluebell_keyword": "PART",
          "numbering": "arabic_continuous",
          "local_terms": {
            "kaz": "Бөлім",
            "rus": "Раздел"
          }
        },
        {
          "local_term": "Glava",
          "akn_element": "chapter",
          "level": "higher",
          "bluebell_keyword": "CHAPTER",
          "numbering": "arabic_continuous",
          "local_terms": {
            "kaz": "Тарау",
            "rus": "Глава"
          }
        },
        {
          "local_term": "Paragraf",
          "akn_element": "section",
          "level": "higher",
          "bluebell_keyword": "SECTION",
          "numbering": "arabic_continuous",
          "local_terms": {
            "kaz": "Параграф",
            "rus": "Параграф"
          },
          "note": "Paragraf is a sub-division of Glava, above the article. Use section element (as higher div). Present only in the Civil Code and a few other large codes; absent from simple laws."
        },
        {
          "local_term": "Stat'ya",
          "akn_element": "article",
          "level": "basic",
          "bluebell_keyword": "ARTICLE",
          "numbering": "arabic_continuous",
          "local_terms": {
            "kaz": "Бап",
            "rus": "Статья"
          }
        },
        {
          "local_term": "Punkt",
          "akn_element": "paragraph",
          "level": "subdivision",
          "bluebell_keyword": "PARAGRAPH",
          "numbering": "arabic_period",
          "local_terms": {
            "kaz": "Тармақ",
            "rus": "Пункт"
          },
          "note": "Numbered with Arabic numeral followed by period: 1. 2. 3."
        },
        {
          "local_term": "Podpunkt",
          "akn_element": "point",
          "level": "subdivision",
          "bluebell_keyword": "POINT",
          "numbering": "arabic_parenthesis",
          "local_terms": {
            "kaz": "Тармақша",
            "rus": "Подпункт"
          },
          "note": "Numbered with Arabic numeral and closing parenthesis: 1) 2) 3). Some laws use letters: a) b) c)."
        },
        {
          "local_term": "Abzac",
          "akn_element": "indent",
          "level": "subdivision",
          "bluebell_keyword": "INDENT",
          "numbering": "unnumbered",
          "local_terms": {
            "kaz": "Абзац",
            "rus": "Абзац"
          },
          "note": "Unnumbered indent/paragraph within a punkt. Cited by sequential position."
        }
      ],
      "hcontainers": [],
      "note": "Simple laws (Zakon) typically begin directly at Glava or Stat'ya level without Razdel. Razdel appears mainly in large codes. Article numbering is continuous throughout the act, not restarting per chapter. Inserted articles use decimal notation: 5-1, 5-2."
    },
