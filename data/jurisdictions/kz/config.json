          "local_terms": {
            "kaz": "Тармақша",
            "rus": "Подпункт"
          }
        },
        {
          "local_term": "Abzac",
          "akn_element": "indent",
          "level": "subdivision",
          "bluebell_keyword": "INDENT",
          "numbering": "unnumbered",
          "local_terms": {
            "kaz": "Абзац",
            "rus": "Абзац"
          }
        }
      ],
      "hcontainers": [
        {
          "local_term": "Primechaniye",
          "name": "primechaniye",
          "description": "Note appended to an article with full legal force (common in Criminal Code). Equivalent to Russian primechaniye.",
          "bluebell_proxy": "SUBSECTION",
          "requires_postprocessing": true
        }
      ],
      "note": "Codes use continuous article numbering across the entire code (not restarting per chapter). Criminal Code General Part uses Razdel (I-VII); Special Part uses Glava. Inserted articles use hyphen-decimal notation: Stat'ya 5-1. Razdel in a kodeks maps to book (below the named Chast') rather than part."
    },
