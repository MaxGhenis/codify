  "enacting_formulae": [
    {
      "text": "Au nom du peuple,\nL'Assemblée des représentants du peuple ayant adopté,\nLe Président de la République promulgue la loi dont la teneur suit :",
      "position": "preamble",
      "era": "post-2022-constitution",
      "from": "2022-08-16",
      "document_class": "loi"
    },
    {
      "text": "Le Président de la République,\nVu la Constitution,\nVu le décret présidentiel n° 2021-117 du 22 septembre 2021 [...],\nPrend le décret-loi dont la teneur suit :",
      "position": "preamble",
      "era": "exceptional-measures",
      "from": "2021-07-25",
      "to": "2022-08-16",
      "document_class": "decret-loi"
    },
    {
      "text": "Le Président de la République,\nVu la Constitution, notamment ses articles [...],\nPrend le décret présidentiel dont la teneur suit :",
      "position": "preamble",
      "era": "current",
      "document_class": "decret-presidentiel"
    },
    {
      "text": "Le Chef du Gouvernement,\nSur proposition du ministre [...],\nVu la Constitution, notamment ses articles [...],\nPrend le décret gouvernemental dont la teneur suit :",
      "position": "preamble",
      "era": "current",
      "document_class": "decret-gouvernemental"
    }
  ],
  "amendments": {
    "style": "textual_francophone",
    "phrasing": "est modifié comme suit / est ajouté / est abrogé",
