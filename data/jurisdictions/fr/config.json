  "frbr": {
    "country_code": "fr",
    "uri_patterns": {
      "loi": "/akn/fr/act/{year}/{number}",
      "loi_organique": "/akn/fr/act/lo/{year}/{number}",
      "ordonnance": "/akn/fr/act/ord/{year}/{number}",
      "decret": "/akn/fr/act/decret/{year}/{number}",
      "constitution": "/akn/fr/act/constitution/1958/constitution",
      "bill": "/akn/fr/bill/{year}/{number}"
    },
    "date_calendar": "gregorian",
    "note": "French law numbers follow the pattern YYYY-NNN (e.g., loi n° 2023-270). The JORF number is the canonical publication reference. Codes are identified by their conventional short name slug (code-civil, code-penal, code-du-travail)."
  },
  "numbering": {
    "act_citation": "Loi n° {year}-{number} du {day} {month} {year}",
    "act_citation_alt": "JORF n° {jorf_number} du {day} {month} {year}",
    "insertion_style": "hyphen_suffix",
    "note": "Laws are cited by their number and publication date: 'Loi n° 2023-270 du 14 avril 2023'. In codes, inserted articles use hyphen notation: after art. L.123-4 comes L.123-4-1, L.123-4-2. Article numbering in codes encodes hierarchical position."
  },
