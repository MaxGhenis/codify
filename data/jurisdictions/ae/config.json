  "authoritative_language": "ara",
  "note": "Three distinct legal sub-systems require separate hierarchy profiles: (1) federal/emirate civil law — article-based; (2) DIFC (Dubai) — English common law, section-based; (3) ADGM (Abu Dhabi) — English common law, section-based. This config covers the federal/emirate tradition. DIFC and ADGM use document_class overrides.",
  "document_classes": {
    "federal_law": {
      "label": "Federal Law",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "article",
      "prompt_variant": "ae",
      "hierarchy": [
        {
          "local_term": "Book",
          "local_term_ara": "كتاب",
          "akn_element": "book",
          "level": "higher",
          "bluebell_keyword": "BOOK",
          "numbering": "ordinal_words",
          "note": "Codes only (e.g., Civil Code has 5 Books). Most laws do not use Book."
        },
        {
          "local_term": "Part",
          "local_term_ara": "باب",
          "akn_element": "part",
          "level": "higher",
          "bluebell_keyword": "PART",
          "numbering": "ordinal_words",
          "note": "Primary higher division in most federal laws. English translations use 'Part', 'Title', or 'Chapter' for باب."
        },
        {
          "local_term": "Chapter",
          "local_term_ara": "فصل",
          "akn_element": "chapter",
          "level": "higher",
          "bluebell_keyword": "CHAPTER",
          "numbering": "ordinal_words"
        },
        {
          "local_term": "Article",
          "local_term_ara": "مادة",
          "akn_element": "article",
          "level": "basic",
          "bluebell_keyword": "ARTICLE",
          "numbering": "arabic_continuous",
          "note": "Basic citable unit throughout all UAE federal legislation. Continuous numbering regardless of chapter boundaries."
        },
        {
          "local_term": "Clause",
          "local_term_ara": "بند",
          "akn_element": "subsection",
          "level": "subdivision",
          "bluebell_keyword": "SUBSECTION",
          "numbering": "arabic_parenthesized",
          "note": "First subdivision of an article. Cited as 'Clause (1) of Article 5' or 'Article 5(1)'."
        },
        {
          "local_term": "Sub-clause",
          "akn_element": "paragraph",
          "level": "subdivision",
          "bluebell_keyword": "PARAGRAPH",
          "numbering": "alpha_lower_parenthesized",
          "note": "Second subdivision. Some laws use uppercase (A), (B) instead of (a), (b)."
        },
        {
          "local_term": "Item",
          "akn_element": "subparagraph",
          "level": "subdivision",
          "bluebell_keyword": "SUBPARAGRAPH",
          "numbering": "arabic_closing_paren",
          "note": "Third subdivision. Rare. Format: 1), 2), 3)."
        }
      ],
      "hcontainers": [
        {
          "local_term": "Annex",
          "local_term_ara": "ملحق",
          "akn_element": "attachment",
          "note": "Federal annexes. Wrapped in <attachments><attachment>.",
          "name": "annex"
        }
      ]
    },
