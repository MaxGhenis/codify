  "frbr": {
    "country_code": "az",
    "uri_patterns": {
      "law": "/akn/az/act/{year}/{number}",
      "bill": "/akn/az/bill/{year}/{number}",
      "constitution": "/akn/az/act/constitution/1995/constitution",
      "decree": "/akn/az/act/decree/{year}/{number}",
      "resolution": "/akn/az/act/resolution/{year}/{number}"
    },
    "date_calendar": "gregorian",
    "number_format": "sequential_digits_only",
    "note": "FRBR URI uses sequential digits only (e.g. 736). Full law designation (e.g. 736-IQ) stored as <FRBRalias name='lawNumber'>. Codes use slugified names."
  },
  "numbering": {
    "insertion_style": "hyphenated_article",
    "insertion_example": "49-1",
    "note": "Convocation suffix: IQ (1st), IIQ (2nd), IIIQ (3rd), IVQ (4th), VQ (5th), VIQ (6th), VIIQ (7th). Constitutional laws add D suffix (e.g. IIIQD)."
  },
  "amendments": {
