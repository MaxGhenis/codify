      "bluebell_compatible": true,
      "basic_unit": "article",
      "hierarchy": [
        {
          "local_term": "Bölmə",
          "akn_element": "part",
          "level": "higher",
          "bluebell_keyword": "PART",
          "numbering": "roman",
          "note": "Top-level grouping in codes; absent in shorter laws"
        },
        {
          "local_term": "Fəsil",
          "akn_element": "chapter",
          "level": "higher",
          "bluebell_keyword": "CHAPTER",
          "numbering": "arabic_continuous"
        },
        {
          "local_term": "Maddə",
          "akn_element": "article",
          "level": "basic",
          "bluebell_keyword": "ARTICLE",
          "numbering": "arabic_continuous"
        },
        {
          "local_term": "N.1 (decimal L1)",
          "akn_element": "paragraph",
          "level": "subdivision",
          "bluebell_keyword": "PARAGRAPH",
          "numbering": "decimal_dot",
          "note": "e.g. 5.1 — num element contains the full decimal string"
        },
        {
          "local_term": "N.1.1 (decimal L2)",
          "akn_element": "subparagraph",
          "level": "subdivision",
          "bluebell_keyword": "SUBPARAGRAPH",
          "numbering": "decimal_dot",
          "note": "e.g. 5.1.1"
        },
        {
          "local_term": "N.1.1.1 (decimal L3, rare)",
          "akn_element": "point",
          "level": "subdivision",
          "bluebell_keyword": "POINT",
          "numbering": "decimal_dot",
          "note": "e.g. 5.1.1.1 — used sparingly in codes"
        }
      ],
      "hcontainers": [
        {
          "name": "transitionalProvisions",
          "local_term": "Keçid müddəaları",
          "note": "Transitional provisions section, typically at end of law"
        }
      ],
      "note": "Enacting formula/attestation appears at end of document, not in preamble. Short laws may omit bölmə and/or fəsil levels."
    },
