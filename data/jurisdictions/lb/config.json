          "akn_element": "alinea",
          "level": "subdivision",
          "bluebell_keyword": "ALINEA",
          "numbering": "implicit_sequential"
        }
      ],
      "hcontainers": [],
      "note": "Emergency executive legislation issued by the President and Council of Ministers under special constitutional circumstances. Requires subsequent parliamentary ratification to remain in force. Structurally identical to ordinary laws."
    },
    "decree": {
      "label": "Decree (مرسوم / Décret)",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "article",
      "hierarchy": [
        {
          "local_term": "مادة (Maddah) / Article",
          "akn_element": "article",
          "level": "basic",
          "bluebell_keyword": "ARTICLE",
          "numbering": "arabic_continuous"
        },
        {
          "local_term": "فقرة (Faqra) / Alinéa",
          "akn_element": "alinea",
          "level": "subdivision",
          "bluebell_keyword": "ALINEA",
          "numbering": "implicit_sequential"
        }
      ],
      "hcontainers": [],
      "note": "Regulatory/administrative decrees (not primary legislation). Signed by President and countersigned by relevant minister(s). Very high sequential numbers (e.g., Decree No. 11230). Typically short — mostly just articles. Published in Al-Jarida Al-Rasmiyya."
    },
    "personal_status": {
      "label": "Personal Status Law (قانون الأحوال الشخصية)",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "article",
      "hierarchy": [
        {
          "local_term": "باب (Bab) / Titre / Titulus",
          "akn_element": "title",
          "level": "higher",
          "bluebell_keyword": "TITLE",
          "numbering": "roman_or_ordinal_arabic"
        },
        {
          "local_term": "فصل (Fasl) / Chapitre / Caput",
          "akn_element": "chapter",
          "level": "higher",
          "bluebell_keyword": "CHAPTER",
          "numbering": "roman_or_ordinal_arabic"
        },
        {
          "local_term": "مادة (Maddah) / Article / Canon",
          "akn_element": "article",
          "level": "basic",
          "bluebell_keyword": "ARTICLE",
          "numbering": "arabic_continuous"
        },
        {
          "local_term": "فقرة (Faqra) / Alinéa",
          "akn_element": "alinea",
          "level": "subdivision",
          "bluebell_keyword": "ALINEA",
          "numbering": "implicit_sequential"
        }
      ],
      "hcontainers": [
        {
          "local_term": "Note / تنبيه",
          "name": "proviso",
          "description": "Proviso or conditional note attached to an article, sometimes with independent legal force in confessional court practice",
          "bluebell_proxy": "PROVISO",
          "requires_postprocessing": false
        }
      ],
      "note": "Applies to Parliament-ratified personal status instruments for Lebanon's 18 recognised religious communities. Structural terminology varies by community: Islamic courts use Arabic jurisprudential terms; Christian communities may use Latin canon law terms (Titulus, Canon) or their Arabic/French equivalents. Model each community's instruments using the closest AKN mapping. See profile.md for the full list of 18 communities and their court systems."
    },
    "constitution": {
      "label": "Constitution (الدستور / Constitution)",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "article",
      "hierarchy": [
        {
          "local_term": "مادة (Maddah) / Article",
          "akn_element": "article",
          "level": "basic",
          "bluebell_keyword": "ARTICLE",
          "numbering": "arabic_continuous",
          "note": "Articles 1–102 (as amended through 1990 Taif). No higher structural divisions in the constitution itself beyond the Preamble/Body distinction."
        }
      ],
      "hcontainers": [
        {
          "local_term": "Preamble / المقدمة",
          "name": "preamble",
          "description": "Constitutional Preamble added by Taif Agreement amendments (1990). Distinct constitutional status — part of the constitutional bloc (bloc de constitutionnalité). Not a simple introductory paragraph. Model as hcontainer within preface.",
          "bluebell_proxy": "SUBSECTION",
          "requires_postprocessing": false
        }
      ],
      "note": "Constitution of 23 May 1926 (as amended through 1990 Taif Agreement). 102 articles, no higher structural divisions within the body. The 1990 preamble has full constitutional force per Constitutional Council jurisprudence. Each amendment round is a separate FRBR expression of the 1926 work."
    }
  },
  "default_document_class": "law",
  "frbr": {
    "country_code": "lb",
    "uri_patterns": {
      "law": "/akn/lb/act/{year}/{number}",
      "legislative_decree": "/akn/lb/act/legislative-decree/{year}/{number}",
      "decree_law": "/akn/lb/act/decree-law/{year}/{number}",
      "decree": "/akn/lb/act/decree/{year}/{number}",
      "constitution": "/akn/lb/act/constitution/1926/constitution",
      "ottoman_era": "/akn/lb/act/ottoman/{year}/{number}"
    },
    "date_calendar": "gregorian",
    "note": "Law number taken from 'Law No. {number}/{year}' citation. Arabic-Indic numerals (١-٩) in source documents must be normalised to Western Arabic (1-9) for URI construction. For laws cited by date only (pre-numbering era), use slugified subject descriptor as number segment. Ottoman-era laws still in force receive URIs under lb/act/ottoman/ with metadata noting original Ottoman provenance."
  },
  "numbering": {
    "act_citation": "Law No. {number}/{year}",
    "article_numbering": "continuous_throughout_law",
    "insertion_style": "mkarran_or_hyphen",
    "note": "Insertion style inconsistent across eras and drafters. Mandate-era and French-tradition instruments use hyphen suffix (-1, -2); Arabic-tradition instruments use mكرراً (mkarran/bis). Detect per document and record in metadata."
  },
  "amendments": {
    "style": "textual_civil_law",
    "cross_reference_format": "law_number_and_date"
  },
