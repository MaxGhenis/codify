  ],
  "authoritative_language": "ara",
  "document_classes": {
    "law": {
      "label": "Law (قانون / Loi)",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "article",
      "hierarchy": [
        {
          "local_term": "كتاب (Kitab) / Livre",
          "akn_element": "book",
          "level": "higher",
          "bluebell_keyword": "BOOK",
          "numbering": "roman_or_ordinal_arabic",
          "note": "Major codes only (Penal Code, Code of Obligations and Contracts). Rare in standalone laws."
        },
        {
          "local_term": "باب (Bab) / Titre",
          "akn_element": "title",
          "level": "higher",
          "bluebell_keyword": "TITLE",
          "numbering": "roman_or_ordinal_arabic",
          "note": "Primary structural grouping. Maps to AKN title (not chapter). باب الأول, Titre I."
        },
        {
          "local_term": "فصل (Fasl) / Chapitre",
          "akn_element": "chapter",
          "level": "higher",
          "bluebell_keyword": "CHAPTER",
          "numbering": "roman_or_ordinal_arabic",
          "note": "Sub-grouping below Bab/Titre. الفصل الأول, Chapitre I."
        },
        {
          "local_term": "قسم (Qism) / Section",
          "akn_element": "section",
          "level": "higher",
          "bluebell_keyword": "DIVISION",
          "numbering": "arabic",
          "note": "Section as HIGHER division above articles. Bluebell workaround: DIVISION keyword; post-process <division> → <section>. قسم is a higher division, not the basic unit."
        },
        {
          "local_term": "مادة (Maddah) / Article",
          "akn_element": "article",
          "level": "basic",
          "bluebell_keyword": "ARTICLE",
          "numbering": "arabic_continuous",
          "note": "THE basic citable unit. Numbered continuously throughout the entire law regardless of higher division boundaries. Never restarts per Bab or Fasl."
        },
        {
          "local_term": "فقرة (Faqra) / Alinéa",
          "akn_element": "alinea",
          "level": "subdivision",
          "bluebell_keyword": "ALINEA",
          "numbering": "implicit_sequential",
          "note": "Paragraph break within an article. Usually unnumbered. Some modern laws use (1), (2). Post-process: <paragraph> → <alinea>."
        },
        {
          "local_term": "بند (Band) / Point",
          "akn_element": "point",
          "level": "subdivision",
          "bluebell_keyword": "POINT",
          "numbering": "arabic_or_alpha",
          "note": "Lettered or numbered list items within an alinéa: (أ), (ب), (ج) or (a), (b), (c) or 1., 2., 3."
        }
      ],
      "hcontainers": [],
      "note": "Standard parliamentary law (قانون). Article is always the basic unit. Most standalone laws use only Bab/Titre > Article; larger laws and codes add Fasl/Chapitre and Qism/Section. Article numbering is continuous throughout regardless of higher divisions."
    },
    "legislative_decree": {
      "label": "Legislative Decree (مرسوم تشريعي / Décret législatif)",
      "akn_element": "act",
      "bluebell_compatible": true,
