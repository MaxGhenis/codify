          "bluebell_keyword": "ARTICLE",
          "numbering": "arabic_continuous"
        },
        {
          "local_term": "فقرة (Faqra) / Alinéa",
          "akn_element": "alinea",
          "level": "subdivision",
          "bluebell_keyword": "ALINEA",
          "numbering": "implicit_sequential"
        },
        {
          "local_term": "بند (Band) / Point",
          "akn_element": "point",
          "level": "subdivision",
          "bluebell_keyword": "POINT",
          "numbering": "arabic_or_alpha"
        }
      ],
      "hcontainers": [],
      "note": "Executive legislation enacted when Parliament is suspended or during Mandate period. Structurally identical to ordinary laws. Distinguished by enacting formula (President/Council of Ministers, not Chamber of Deputies) and FRBR subtype 'legislative-decree'. Includes major codes: Penal Code (No. 340/1943), Code of Criminal Procedure."
    },
    "decree_law": {
      "label": "Decree-Law (مرسوم بقوة القانون)",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "article",
      "hierarchy": [
        {
