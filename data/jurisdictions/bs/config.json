  "structuring": {
    "prompt_additions": "The Bahamas uses PART > SECTION (not CHAPTER > SECTION) in ordinary legislation. The Constitution uses CHAPTER > ARTICLE. The Penal Code (CH.84 only) uses BOOK > TITLE > SECTION. Sections are numbered continuously (not restarting per Part). Section 1 = short title; Section 2 = interpretation. The enacting formula begins 'BE IT ENACTED by the Senate and House of Assembly of the Commonwealth of The Bahamas...' or 'Enacted by the Parliament of The Bahamas'.",
    "marker_boundary": "line_anchored",
    "classification_rules": [
      {
        "signal": "title_regex",
        "pattern": "^(?!.*\\bAct\\b).*\\b(?:Order|Regulations?|Rules?)\\b",
        "pattern_flags": "i",
        "target_document_class": "si",
        "priority": 50
      },
      {
        "signal": "title_regex",
        "pattern": "\\bConstitution\\b",
        "pattern_flags": "i",
        "target_document_class": "constitution",
        "priority": 100
      },
      {
        "signal": "title_regex",
        "pattern": "^Penal Code\\b",
        "pattern_flags": "i",
        "target_document_class": "penal_code",
        "priority": 100
      }
    ]
  },
