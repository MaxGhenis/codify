  "structuring": {
    "marker_boundary": "line_anchored",
    "classification_rules": [
      {
        "signal": "title_regex",
        "pattern": "^(?!.*\\bAct\\b).*\\b(?:Order|Regulations?|Rules?)\\b",
        "pattern_flags": "i",
        "target_document_class": "si",
        "priority": 50
      },
      {
        "signal": "title_regex",
        "pattern": "\\bConstitution\\b",
        "pattern_flags": "i",
        "target_document_class": "constitution",
        "priority": 100
      },
      {
        "signal": "title_regex",
        "pattern": "^Penal Code\\b",
        "pattern_flags": "i",
        "target_document_class": "penal_code",
        "priority": 100
      }
    ]
  },
