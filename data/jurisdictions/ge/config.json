  "document_classes": {
    "law": {
      "label": "Law of Georgia",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "article",
      "hierarchy": [
        {
          "local_term": "წიგნი (Book)",
          "akn_element": "book",
          "level": "higher",
          "bluebell_keyword": "BOOK",
          "numbering": "arabic",
          "note": "Top-level division in major codes. Civil Code has 5 books (I–V); Criminal Code also uses Book level. Detect 'კოდექსი' in title to enable Book-level hierarchy."
        },
        {
          "local_term": "ნაწილი (Part)",
          "akn_element": "part",
          "level": "higher",
          "bluebell_keyword": "PART",
          "numbering": "arabic",
          "note": "Optional intermediate division. Ordering: Book > Part > Chapter > Article where used. Confirmed standard continental convention."
        },
        {
          "local_term": "თავი (Chapter)",
          "akn_element": "chapter",
          "level": "higher",
          "bluebell_keyword": "CHAPTER",
          "numbering": "arabic",
          "note": "Most common higher division in ordinary legislation. Typical pattern: CHAPTER > ARTICLE."
        },
        {
          "local_term": "მუხლი (Article)",
          "akn_element": "article",
          "level": "basic",
          "bluebell_keyword": "ARTICLE",
          "numbering": "arabic_continuous"
        },
        {
          "local_term": "პუნქტი (Paragraph/Point)",
          "akn_element": "paragraph",
          "level": "subdivision",
          "bluebell_keyword": "PARAGRAPH",
          "numbering": "arabic_parenthesized",
          "note": "Maps to AKN 'paragraph' (not 'subsection'). Civil law tradition confirmed by DE/AM precedent: first-level article subdivision is paragraph. Subsection carries Anglophone connotations not applicable here."
        },
        {
          "local_term": "ქვეპუნქტი (Sub-point)",
          "akn_element": "subparagraph",
          "level": "subdivision",
          "bluebell_keyword": "SUBPARAGRAPH",
          "numbering": "georgian_alpha_parenthesized",
          "note": "eId normalisation: ISO 9984 Georgian National Transliteration (ა→a, ბ→b, გ→g, დ→d, ე→e, ვ→v, ზ→z, თ→t, ი→i, კ→k, ლ→l, მ→m, ნ→n, ო→o, პ→p, ჟ→zh, რ→r, ს→s, ტ→t2, უ→u, ფ→p2, ქ→k2, ღ→gh, ყ→q, შ→sh, ჩ→ch, ც→ts, ძ→dz, წ→ts2, ჭ→ch2, ხ→kh, ჯ→j, ჰ→h). In practice subparagraph enumeration only uses ა–ჰ sequentially; the transliteration table covers all 33 letters. Decision: ISO 9984 preferred over sequential integers because it is traceable back to the Georgian letter and is the official Georgian government standard."
        }
      ],
      "hcontainers": []
    },
