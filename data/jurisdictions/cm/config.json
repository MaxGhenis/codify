    "constitution": {
      "label": "Constitution",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "article",
      "hierarchy": [
        {
          "local_term": "Partie / Part",
          "akn_element": "part",
          "level": "higher",
          "bluebell_keyword": "PART",
          "numbering": "roman",
          "note": "Constitution uses PARTIE (French) / PART (English) — Anglophone term adopted into bilingual constitution. 13 Parts."
        },
        {
          "local_term": "Article",
          "akn_element": "article",
          "level": "basic",
          "bluebell_keyword": "ARTICLE",
          "numbering": "arabic_continuous"
        }
      ],
      "hcontainers": [],
      "note": "Constitution of 1972, as revised. Uses PARTIE/PART (not TITRE/TITLE) as highest division — unique to the constitution. Articles numbered continuously (Art. 1 through Art. 68 approx)."
    }
  },
  "default_document_class": "loi",
  "frbr": {
    "country_code": "cm",
    "uri_patterns": {
      "loi": "/akn/cm/act/{year}/{number}",
      "ordonnance": "/akn/cm/act/ordonnance/{year}/{number}",
      "decret": "/akn/cm/act/decret/{year}/{number}",
      "bill": "/akn/cm/bill/{year}/{number}",
      "constitution": "/akn/cm/act/constitution/1972/constitution"
    },
    "number_format": "YYYY/NNN",
    "date_calendar": "gregorian"
  },
  "numbering": {
    "insertion_style": "hyphen_or_bis",
    "note": "Year/number separator is forward slash (/) not hyphen. Numbers are zero-padded to 3 digits. Pre-1990 laws used two-digit years (YY/NNN); expand to YYYY in URIs."
  },
  "amendments": {
    "style": "textual_french",
    "phrasing": "modifiant et complétant certaines dispositions de la loi n° {number} du {date}",
    "cross_reference_format": "loi_number_and_date"
  },
