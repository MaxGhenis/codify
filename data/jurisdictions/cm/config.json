  "document_classes": {
    "loi": {
      "label": "Loi / Law",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "article",
      "hierarchy": [
        {
          "local_term": "Livre / Book",
          "akn_element": "book",
          "level": "higher",
          "bluebell_keyword": "BOOK",
          "numbering": "roman",
          "note": "Used only in large codes (Code pénal has Livre I, Livre II); absent from most ordinary laws."
        },
        {
          "local_term": "Titre / Title",
          "akn_element": "title",
          "level": "higher",
          "bluebell_keyword": "TITLE",
          "numbering": "roman"
        },
        {
          "local_term": "Chapitre / Chapter",
          "akn_element": "chapter",
          "level": "higher",
          "bluebell_keyword": "CHAPTER",
          "numbering": "roman"
        },
        {
          "local_term": "Section (higher) / Section",
          "akn_element": "division",
          "level": "higher",
          "bluebell_keyword": "DIVISION",
          "numbering": "roman",
          "note": "Higher division grouping articles — NOT the basic unit. DIVISION keyword avoids collision. Absent in short laws."
        },
        {
          "local_term": "Article / Section (basic)",
          "akn_element": "article",
          "level": "basic",
          "bluebell_keyword": "ARTICLE",
          "numbering": "arabic_continuous",
          "note": "French: 'Article 1er', 'Article 2'. English parallel: 'Section 1', 'Section 2'. Both map to AKN article. Continuous throughout the entire law regardless of higher divisions."
        },
        {
          "local_term": "Alinéa / Subsection",
          "akn_element": "alinea",
          "level": "subdivision",
          "bluebell_keyword": null,
          "numbering": "sequential_implicit",
          "note": "Unnumbered paragraph within article. No Bluebell keyword; requires post-processing."
        },
        {
          "local_term": "Point (1°, 2°…)",
          "akn_element": "point",
          "level": "subdivision",
          "bluebell_keyword": "POINT",
          "numbering": "ordinal_degree"
        },
        {
          "local_term": "Tiret (–)",
          "akn_element": "indent",
          "level": "subdivision",
          "bluebell_keyword": "INDENT",
          "numbering": "sequential_implicit"
        }
      ],
      "hcontainers": []
    },
    "code": {
