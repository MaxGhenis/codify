          "local_term": "Article",
          "akn_element": "article",
          "level": "basic",
          "bluebell_keyword": "ARTICLE",
          "numbering": "arabic_continuous"
        }
      ],
      "hcontainers": [],
      "note": "Constitution of 1972, as revised. Uses PARTIE/PART (not TITRE/TITLE) as highest division — unique to the constitution. Articles numbered continuously (Art. 1 through Art. 68 approx)."
    }
