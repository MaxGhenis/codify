          "bluebell_keyword": "INDENT",
          "numbering": "sequential_implicit"
        }
      ],
      "hcontainers": [],
      "note": "Codes receive a stable 'code-{slug}' subtype in the FRBR URI so they maintain identity across amendments. English text uses 'Section N' for the basic unit (Article N in French)."
    },
    "ordonnance": {
      "label": "Ordonnance",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "article",
