  "default_document_class": "loi",
  "frbr": {
    "country_code": "cm",
    "uri_patterns": {
      "loi": "/akn/cm/act/{year}/{number}",
      "ordonnance": "/akn/cm/act/ordonnance/{year}/{number}",
      "decret": "/akn/cm/act/decret/{year}/{number}",
      "bill": "/akn/cm/bill/{year}/{number}",
      "constitution": "/akn/cm/act/constitution/1972/constitution"
    },
    "number_format": "YYYY/NNN",
    "number_separator": "/",
    "number_zero_padded": true,
    "number_digits": 3,
    "date_calendar": "gregorian",
    "language_codes": [
      "fra",
      "eng"
    ],
    "expression_note": "Both fra and eng are co-equal parallel originals. Neither uses FRBRtranslation. Expression URI: /akn/cm/act/{year}/{number}/{lang}@{date}."
  },
  "numbering": {
    "loi_citation": "Loi n° {year}/{number} du {day} {month} {year}",
    "loi_citation_en": "Law No {year}/{number} of {day} {month} {year}",
    "ordonnance_citation": "Ordonnance n° {year}/{number} du {day} {month} {year}",
    "decret_citation": "Décret n° {year}/{number} du {day} {month} {year}",
    "article_first": "Article 1er",
    "article_first_en": "Section 1",
    "article_subsequent": "Article {number}",
    "article_subsequent_en": "Section {number}",
    "insertion_style": "hyphen_or_bis",
    "insertion_examples": [
      "Art. 5 bis",
      "Art. 5 ter",
      "Art. 5-1",
      "Art. 5-2"
    ],
    "note": "Year/number separator is forward slash (/) not hyphen. Numbers are zero-padded to 3 digits. Pre-1990 laws used two-digit years (YY/NNN); expand to YYYY in URIs."
  },
  "enacting_formulae": [
    {
      "text": "L'Assemblée nationale et le Sénat ont délibéré et adopté, le Président de la République promulgue la loi dont la teneur suit :",
      "text_en": "The National Assembly and the Senate deliberated and adopted, the President of the Republic hereby promulgates the Law set out below:",
      "position": "preamble",
      "era": "bicameral_current",
      "from": "2013-01-01",
      "verified": true,
      "note": "Formula confirmed from Cameroon legislative practice. Senate first sat in 2013 (100 senators sworn in May 2013). Bicameral formula confirmed as standard from Cameroon Tribune reports on 2024 laws. Source: https://www.senat.cm/ and https://www.cameroon-tribune.cm/",
      "document_class": "loi"
    },
    {
      "text": "L'Assemblée nationale a délibéré et adopté, le Président de la République promulgue la loi dont la teneur suit :",
      "text_en": "The National Assembly deliberated and adopted, the President of the Republic hereby promulgates the Law set out below:",
      "position": "preamble",
      "era": "unicameral_transitional",
      "from": "1996-01-18",
      "to": "2013-01-01",
      "note": "Senate created by 1996 Constitution but did not sit until 2013. Unicameral formula used during this period.",
      "document_class": "loi"
    },
    {
      "text": "Le Président de la République,\nVu la Constitution, notamment en ses articles {articles} ;\nVu {parent_instruments} ;\n{additional_vus}\nPromulgue l'ordonnance dont la teneur suit :",
      "position": "preamble",
      "era": "ordonnance",
      "note": "Ordonnance enabling clause. 'Vu' recitals cite constitutional basis and enabling legislation. Promulgated by President under Art. 28.",
      "document_class": "ordonnance"
    },
    {
      "text": "Le Président de la République,\nVu la Constitution, notamment en ses articles {articles} ;\n{additional_vus}\nDécrète :",
      "position": "preamble",
      "era": "decret",
      "note": "Decree enabling clause.",
      "document_class": "decret"
    }
  ],
