  "structuring": {
    "prompt_variant": null,
    "prompt_additions": "Body-fill task only. Preserve citations, inline markup, and list numbering verbatim. Never emit structural keywords — the scaffold owns hierarchy.",
    "long_title_lead_ins": ["An Act"],
    "citation_lead_ins": ["shall be known as", "may be cited as", "shall be cited as"],
    "citation_subjects": ["This Act", "This Code", "This Circular", "These Rules"],
    "citation_articles": ["the"],
    "prose_precursors": ["provided in", "defined under"],
    "classification_rules": [
      {
        "signal": "title_regex",
        "pattern": "^(?:An Act to Ordain and Institute the )?Civil Code of Atlantis$",
        "pattern_flags": "i",
        "target_document_class": "code",
        "priority": 100
      },
      {
        "signal": "title_regex",
        "pattern": "^(?:The )?Consolidated Penal Code(?: of Atlantis)?$",
        "pattern_flags": "i",
        "target_document_class": "code",
        "priority": 100
      },
      {
        "signal": "title_regex",
        "pattern": "^(?:The )?\\d{4} Constitution|Constitution of the Commonwealth of Atlantis",
        "pattern_flags": "i",
        "target_document_class": "constitution",
        "priority": 110
      },
      {
        "signal": "title_regex",
        "pattern": "^(?:Atlantis\\s+)?Mint\\s+Circular\\s+(?:No\\.?\\s*)?\\d+\\b",
        "pattern_flags": "i",
        "target_document_class": "mint_circular",
        "priority": 120
      },
      {
        "signal": "preamble_match",
        "pattern": "\\A(?=[\\s\\S]{0,1600}Atlantis\\s+Mint)[\\s\\S]{0,160}?OFFICE OF THE MINT WARDEN[\\s\\S]{0,120}?CIRCULAR\\s+(?:NO\\.?|NUMBER)[\\s\\S]{0,1400}?The\\s+Mint\\s+Council,?\\s+in\\s+its\\s+Resolution\\s+No\\.?\\s+\\d+(?:[-/]\\d+)?\\s+dated\\s+\\d{1,2}\\s+[A-Za-z]+\\s+\\d{4},?\\s+approved\\s+the\\s+following\\b",
        "pattern_flags": "i",
        "target_document_class": "mint_circular",
        "priority": 115
      },
      {
        "signal": "title_regex",
        "pattern": "^HB\\s*[-/–]\\s*TR\\s+(?:Joint\\s+Memorandum\\s+Circular|JMC)\\s+(?:No\\.?\\s*)?\\d{4}\\s*[-–]\\s*\\d+\\b",
        "pattern_flags": "i",
        "target_document_class": "harbour_treasury_jmc",
        "priority": 125
      },
      {
        "signal": "preamble_match",
        "pattern": "\\A\\s*JOINT\\s+MEMORANDUM\\s+CIRCULAR\\s+NO\\.?\\s*\\d{4}\\s*[-–]\\s*\\d+\\s*(?:Series\\s+of\\s+\\d{4}\\s*)?(?:The\\s+)?Implementing\\s+Rules\\s+of\\s+the\\s+Harbours\\s+Act\\s+No\\.?\\s*1103\\b",
        "pattern_flags": "i",
        "target_document_class": "harbour_treasury_jmc",
        "priority": 124,
        "note": "Needs the instrument heading and the implemented statute together; a body citation does not identify the issuer."
      }
    ]
  },
