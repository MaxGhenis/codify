  "enacting_formulae": [
    {
      "text": "Be it enacted by the President with the advice and consent of the Parliament of Singapore, as follows:",
      "position": "preamble",
      "era": "republic",
      "from": "1965-08-09",
      "document_class": "act"
    },
    {
      "text": "[Minister], in exercise of the powers conferred by section [N] of the [Parent Act], hereby makes the following Regulations:",
      "position": "preamble",
      "era": "current",
      "note": "Enabling power section and parent Act always cited. Instrument type varies: Regulations, Rules, Order, Notification.",
      "document_class": "sl"
    }
  ],
  "amendments": {
