          "numbering": "roman"
        },
        {
          "local_term": "Điều",
          "akn_element": "article",
          "level": "basic",
          "bluebell_keyword": "ARTICLE",
          "numbering": "arabic_continuous"
        },
        {
          "local_term": "Khoản",
          "akn_element": "paragraph",
          "level": "subdivision",
          "bluebell_keyword": "PARAGRAPH",
          "numbering": "arabic"
        }
      ],
      "hcontainers": [],
      "note": "Constitution 2013 (current). Chapters numbered in Roman numerals. No Phần or Mục level. No Điểm level used in the Constitution."
    }
