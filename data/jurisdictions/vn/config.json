  "default_document_class": "luat",
  "frbr": {
    "country_code": "vn",
    "uri_patterns": {
      "luat": "/akn/vn/act/{year}/{number}",
      "boluat": "/akn/vn/act/{year}/{number}",
      "phaplenhh": "/akn/vn/act/ordinance/{year}/{number}",
      "nghi_dinh": "/akn/vn/act/decree/{year}/{number}",
      "thong_tu": "/akn/vn/act/circular/{year}/{number}",
