{
  "code": "vn",
  "name": "Việt Nam",
  "name_en": "Vietnam",
  "type": "national",
  "tradition": [
    "socialist",
    "civil_law"
  ],
  "calendar": "gregorian",
  "languages": [
    "vie"
  ],
  "authoritative_language": "vie",
  "document_classes": {
    "luat": {
      "label": "Luật (Law / Act)",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "article",
      "hierarchy": [
        {
          "local_term": "Phần",
          "akn_element": "part",
          "level": "higher",
          "bluebell_keyword": "PART",
          "numbering": "roman",
          "note": "Used only in large codes; absent from most laws"
        },
        {
          "local_term": "Chương",
          "akn_element": "chapter",
          "level": "higher",
          "bluebell_keyword": "CHAPTER",
          "numbering": "roman_or_arabic",
          "note": "Primary higher division; present in almost all laws above ~10 articles"
        },
        {
          "local_term": "Mục",
          "akn_element": "section",
          "level": "higher",
          "bluebell_keyword": "SECTION",
          "numbering": "arabic_continuous",
          "note": "Optional mid-level division between Chương and Điều; verify per document"
        },
        {
          "local_term": "Tiểu mục",
          "akn_element": "subsection",
          "level": "higher",
          "bluebell_keyword": "SUBSECTION",
          "numbering": "arabic_continuous",
          "note": "Rare; observed in Civil Code 2015 between Mục and Điều"
        },
        {
          "local_term": "Điều",
          "akn_element": "article",
          "level": "basic",
          "bluebell_keyword": "ARTICLE",
          "numbering": "arabic_continuous",
          "note": "Fundamental citation unit. Continuous numbering throughout entire document, never restarting per chapter."
        },
        {
          "local_term": "Khoản",
          "akn_element": "paragraph",
          "level": "subdivision",
          "bluebell_keyword": "PARAGRAPH",
          "numbering": "arabic",
          "note": "Primary subdivision of Điều. Cited as 'khoản 2 Điều 5'."
        },
        {
          "local_term": "Điểm",
          "akn_element": "point",
          "level": "subdivision",
          "bluebell_keyword": "POINT",
          "numbering": "vietnamese_alpha",
          "note": "Secondary subdivision. Vietnamese letter sequence: a, b, c, d, đ, e, g, h, i, k. The letter đ is transliterated as 'dd' in eId values."
        }
      ],
      "hcontainers": [
        {
          "local_term": "Phụ lục",
          "note": "Annex/Schedule — use <attachments><attachment> not hcontainer",
          "name": "phuluc"
        }
      ]
    },
    "boluat": {
      "label": "Bộ luật (Code)",
