      "nghi_quyet_qh": "/akn/vn/act/resolution/{year}/{number}",
      "bill": "/akn/vn/bill/{year}/{number}",
      "constitution": "/akn/vn/act/constitution/2013/constitution"
    },
    "number_extraction": "Strip all text after the first '/' in the official designation. E.g., '59/2020/QH14' → number='59', year='2020'. Store the full designation as FRBRalias.",
    "date_calendar": "gregorian"
  },
  "numbering": {
    "act_citation": "{number}/{year}/QH{legislature_term}",
    "insertion_style": "alphabetic_lower",
    "insertion_example": "Điều 5a, Điều 5b (not 5A, 5B)"
  },
  "amendments": {
