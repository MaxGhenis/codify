          "local_term": "Subparagraph",
          "akn_element": "subparagraph",
          "level": "subdivision",
          "bluebell_keyword": "SUBPARAGRAPH",
          "numbering": "roman_lower_parenthesized"
        }
      ],
      "hcontainers": [],
      "note": "GN Regulations use 'regulation N' as basic unit term but map to AKN section. eIds will be sec_N. FRBR URI uses 'gn' subtype: /akn/za/act/gn/{year}/{number}. GN R numbers get lowercase 'r' prefix in number segment (e.g., GN R740 → r740)."
    }
  },
  "default_document_class": "act",
  "frbr": {
    "country_code": "za",
    "uri_patterns": {
      "act": "/akn/za/act/{year}/{number}",
      "regulation": "/akn/za/act/gn/{year}/{number}",
      "bill": "/akn/za/bill/{year}/{number}",
      "constitution": "/akn/za/act/constitution/1996/constitution"
    },
    "date_calendar": "gregorian",
    "notes": "Expression date = gazette publication date (not presidential assent date). Primary expression language: eng. FRBR URI conventions match Laws.Africa reference implementation exactly — do not deviate."
  },
  "numbering": {
    "act_citation": "Act {number} of {year}",
    "act_citation_alt": "Act No. {number} of {year}",
