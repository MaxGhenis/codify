          "bluebell_keyword": "SUBPARAGRAPH",
          "numbering": "roman_lower_parenthesized"
        }
      ],
      "hcontainers": [],
      "note": "14 chapters (arabic numerals), 244 sections numbered continuously 1-244 across all chapters, 8 schedules. No enacting formula — preamble is constitutional declaration. No Parts in the Constitution."
    },
    "regulation": {
      "label": "Regulation (Government Notice)",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "section",
      "hierarchy": [
        {
          "local_term": "Part",
          "akn_element": "part",
          "level": "higher",
          "bluebell_keyword": "PART",
          "numbering": "arabic_or_roman"
        },
        {
          "local_term": "Regulation",
          "akn_element": "section",
          "level": "basic",
          "bluebell_keyword": "SECTION",
          "numbering": "arabic_continuous"
        },
        {
          "local_term": "Subsection",
          "akn_element": "subsection",
          "level": "subdivision",
          "bluebell_keyword": "SUBSECTION",
