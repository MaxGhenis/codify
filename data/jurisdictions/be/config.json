      "hierarchy": [
        {
          "akn_element": "title",
          "level": "higher",
          "bluebell_keyword": "TITLE",
          "numbering": "roman_ordinal",
          "note": "Higher division L1. Roman ordinal: Ier, II, III (FR); I, II, III (NL). Not all acts use Titres.",
          "local_term": "Titre"
        },
        {
          "akn_element": "chapter",
          "level": "higher",
          "bluebell_keyword": "CHAPTER",
          "numbering": "roman_ordinal",
          "note": "Higher division L2. Most acts use at minimum Chapitres.",
          "local_term": "Chapitre"
        },
        {
          "akn_element": "division",
          "level": "higher",
          "bluebell_keyword": "DIVISION",
          "numbering": "arabic_ordinal",
          "note": "Higher division L3. Belgian 'section' is above articles — NOT the basic unit. Map to DIVISION in Bluebell to avoid collision with AKN section-as-basic-unit semantics.",
          "local_term": "Section"
        },
        {
          "akn_element": "subdivision",
          "level": "higher",
          "bluebell_keyword": "SUBDIVISION",
          "numbering": "arabic_ordinal",
          "note": "Higher division L4. Rare — used only in large codes.",
          "local_term": "Sous-section"
        },
        {
          "akn_element": "article",
          "level": "basic",
          "bluebell_keyword": "ARTICLE",
          "numbering": "arabic_continuous",
          "note": "Basic unit. Abbreviated as 'Art.' in text. Continuous Arabic numbering throughout act regardless of Title/Chapter.",
          "local_term": "Article"
        },
        {
          "akn_element": "paragraph",
          "level": "subdivision",
          "bluebell_keyword": "PARAGRAPH",
          "numbering": "section_symbol_ordinal",
          "note": "Formal subdivision within article. § 1er, § 2 (FR); § 1, § 2 (NL). Not all articles have § subdivisions.",
          "local_term": "Paragraphe (§)"
        },
        {
          "akn_element": "alinea",
          "level": "subdivision",
          "bluebell_keyword": "ALINEA",
          "numbering": "sequential_unnumbered",
          "note": "Unnumbered paragraph block within article or §. Proxy-mapped to SUBSECTION in Bluebell; post-processing renames element to alinea in AKN XML.",
          "local_term": "Alinéa"
        },
        {
          "akn_element": "point",
          "level": "subdivision",
          "bluebell_keyword": "POINT",
          "numbering": "degree_notation",
          "note": "Enumerated items using degree notation: 1°, 2°, 3°. Very common in Belgian legislation. Structuring prompt must convert degree notation to POINT N form for Bluebell.",
          "local_term": "Point (1°, 2°...)"
        },
        {
          "akn_element": "indent",
          "level": "subdivision",
          "bluebell_keyword": "INDENT",
          "numbering": "alpha_lower_closing_paren",
          "note": "Sub-items under a numbered point. Lowercase letter with closing parenthesis: a), b), c).",
          "local_term": "Lettre (a), b)...)"
        }
