  "frbr": {
    "country_code": "pe",
    "uri_patterns": {
      "ley": "/akn/pe/act/{year}/{number}",
      "ley_organica": "/akn/pe/act/{year}/{number}",
      "decreto_legislativo": "/akn/pe/act/dl/{year}/{number}",
      "decreto_urgencia": "/akn/pe/act/du/{year}/{number}",
      "decreto_ley": "/akn/pe/act/decreto-ley/{number}",
      "resolucion_legislativa": "/akn/pe/act/rl/{number}",
      "bill": "/akn/pe/bill/{year}/{number}",
      "constitucion": "/akn/pe/act/constitution/1993/constitucion"
    },
    "date_calendar": "gregorian",
    "notes": [
      "Ley numbers are sequential integers since 1904 with no year prefix in the number itself (e.g., Ley N° 27444 enacted 2001 → /akn/pe/act/2001/27444).",
      "Decreto Legislativo numbers are in a separate sequential series (not year-based). Year in URI = El Peruano publication year.",
      "Decreto Supremo numbers are year-based per ministry (e.g., D.S. 003-1997-TR → /akn/pe/act/ds/1997/3-tr).",
      "Decreto Ley numbers are sequential from military-government era (1968-1980); no year in URI.",
      "TUOs (Textos Únicos Ordenados): model as a new FRBR expression of the original work URI, not a new work."
    ]
  },
  "numbering": {
    "insertion_style": "alphanumeric_hyphen",
