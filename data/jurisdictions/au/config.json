          "bluebell_keyword": "SECTION",
          "numbering": "arabic_continuous"
        },
        {
          "local_term": "Subsection",
          "akn_element": "subsection",
          "level": "subdivision",
          "bluebell_keyword": "SUBSECTION",
          "numbering": "arabic_parenthesized"
        }
      ],
      "hcontainers": [],
      "note": "Explanatory Memoranda accompany Bills through Parliament. Published on legislation.gov.au alongside the enrolled Act. Use AKN doc element (not act). Clause-by-clause commentary; structure mirrors the Bill."
    }
  },
