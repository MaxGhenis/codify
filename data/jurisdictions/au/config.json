{
  "code": "au",
  "name": "Australia",
  "type": "national",
  "tradition": [
    "common_law"
  ],
  "calendar": "gregorian",
  "languages": [
    "eng"
  ],
  "authoritative_language": "eng",
  "note": "Federal common-law jurisdiction. Commonwealth Parliament enacts Acts, Legislative Instruments, and Regulations. Six states (NSW, Vic, Qld, WA, SA, Tas) and two territories (ACT, NT) each have their own parliaments. Commonwealth legislation is published on legislation.gov.au via an OData v4 API that serves JSON metadata plus PDF and DOCX downloads; there is no XML or structured full-text representation, so modern Acts are ingested from the style-tagged DOCX without OCR.",
  "document_classes": {
    "act": {
      "label": "Act of Parliament (Commonwealth)",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "section",
      "hierarchy": [
        {
          "local_term": "Chapter",
          "akn_element": "chapter",
          "level": "higher",
          "bluebell_keyword": "CHAPTER",
          "numbering": "arabic"
        },
        {
          "local_term": "Part",
          "akn_element": "part",
          "level": "higher",
          "bluebell_keyword": "PART",
          "numbering": "arabic"
        },
        {
          "local_term": "Division",
          "akn_element": "division",
          "level": "higher",
          "bluebell_keyword": "DIVISION",
          "numbering": "arabic_dotted",
          "note": "Division is a native AKN element with Bluebell keyword DIVISION. In Commonwealth Acts, Divisions are numbered within their Part (e.g. Division 2 of Part 3 → '3.2'). Numbering style is dotted Arabic in modern drafting practice."
        },
        {
          "local_term": "Subdivision",
          "akn_element": "subdivision",
          "level": "higher",
          "bluebell_keyword": "SUBDIVISION",
          "numbering": "alpha_upper_dotted",
          "note": "Subdivisions appear below Divisions in complex Acts (e.g. Corporations Act 2001). Numbered as alphanumeric within Division (e.g. Subdivision A, B, C)."
        },
        {
          "local_term": "Section",
          "akn_element": "section",
          "level": "basic",
          "bluebell_keyword": "SECTION",
          "numbering": "arabic_continuous"
        },
        {
          "local_term": "Subsection",
          "akn_element": "subsection",
          "level": "subdivision",
          "bluebell_keyword": "SUBSECTION",
          "numbering": "arabic_parenthesized"
        },
        {
          "local_term": "Paragraph",
          "akn_element": "paragraph",
          "level": "subdivision",
          "bluebell_keyword": "PARAGRAPH",
          "numbering": "alpha_lower_parenthesized"
        },
        {
          "local_term": "Subparagraph",
          "akn_element": "subparagraph",
          "level": "subdivision",
          "bluebell_keyword": "SUBPARAGRAPH",
          "numbering": "roman_lower_parenthesized"
        }
      ],
      "hcontainers": [],
      "note": "Full Commonwealth hierarchy: Chapter > Part > Division > Subdivision > Section > Subsection > Paragraph > Subparagraph. Not all levels present in every Act. Sections are numbered continuously throughout the Act (not reset per Part). Division and Subdivision are native Bluebell keywords — no hcontainer post-processing required."
    },
