          "akn_element": "subparagraph",
          "level": "subdivision",
          "bluebell_keyword": "SUBPARAGRAPH",
          "numbering": "roman_lower_parenthesized"
        }
      ],
      "hcontainers": [],
      "note": "Bills use 'clause'/'subclause' terminology; maps to section/subsection in AKN. Same structural hierarchy as Acts. Bills before Senate use schedule amendments drafted as separate documents."
    },
    "explanatory_memorandum": {
      "label": "Explanatory Memorandum",
      "akn_element": "doc",
      "bluebell_compatible": true,
      "basic_unit": "section",
      "hierarchy": [
        {
          "local_term": "Part",
          "akn_element": "part",
          "level": "higher",
          "bluebell_keyword": "PART",
          "numbering": "arabic"
        },
        {
          "local_term": "Section",
          "akn_element": "section",
