        {
          "local_term": "Subparagraph",
          "akn_element": "subparagraph",
          "level": "subdivision",
          "bluebell_keyword": "SUBPARAGRAPH",
          "numbering": "roman_lower_parenthesized"
        }
      ],
      "hcontainers": [],
      "note": "Legislative Instruments (formerly Statutory Rules) are subordinate legislation made under Acts. Registered on the Federal Register of Legislation (legislation.gov.au). Simpler hierarchy than Acts — Chapter and Subdivision levels rare. Cited as F20XX/NNNNN."
    },
    "bill": {
      "label": "Bill (Commonwealth Parliament)",
      "akn_element": "bill",
      "bluebell_compatible": true,
      "basic_unit": "section",
      "hierarchy": [
        {
          "local_term": "Chapter",
