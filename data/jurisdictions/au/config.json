          "bluebell_keyword": "SECTION",
          "numbering": "arabic_continuous",
          "note": "Bills use 'clause' as the local term for the basic unit, mapping to AKN section. Becomes 'section' upon enactment."
        },
        {
          "local_term": "Subclause",
          "akn_element": "subsection",
