    },
    "constitution": {
      "label": "Grondwet (Constitution)",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "article",
      "hierarchy": [
        {
          "local_term": "Hoofdstuk",
          "akn_element": "chapter",
          "level": "higher",
          "bluebell_keyword": "CHAPTER",
          "numbering": "roman",
          "note": "Constitution uses Roman numeral chapters (Hoofdstuk I through IX)."
        },
        {
          "local_term": "Artikel",
          "akn_element": "article",
          "level": "basic",
          "bluebell_keyword": "ARTICLE",
          "numbering": "arabic_continuous",
          "note": "Articles numbered continuously across all chapters (1 through 142)."
        },
        {
          "local_term": "Lid",
          "akn_element": "paragraph",
          "level": "subdivision",
          "bluebell_keyword": "PARAGRAPH",
          "numbering": "arabic"
        }
      ],
      "hcontainers": [],
      "note": "The Grondwet has 9 chapters with articles numbered continuously 1–142. Constitutional amendments are enacted by a two-reading procedure (dissolution + re-election between readings)."
    }
