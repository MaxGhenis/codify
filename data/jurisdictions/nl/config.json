  "document_classes": {
    "act": {
      "label": "Wet (Act of Parliament)",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "article",
      "hierarchy": [
        {
          "local_term": "Deel",
          "akn_element": "part",
          "level": "higher",
          "bluebell_keyword": "PART",
          "numbering": "roman",
          "note": "Highest division; used only in large codes (e.g., Burgerlijk Wetboek). Rare in ordinary acts."
        },
        {
          "local_term": "Hoofdstuk",
          "akn_element": "chapter",
          "level": "higher",
          "bluebell_keyword": "CHAPTER",
          "numbering": "arabic_continuous",
          "note": "Most common top-level division in ordinary acts. Numbered Arabic: Hoofdstuk 1, 2, 3."
        },
        {
          "local_term": "Titel",
          "akn_element": "title",
          "level": "higher",
          "bluebell_keyword": "TITLE",
          "numbering": "arabic_continuous",
          "note": "Used in codes between Hoofdstuk and Afdeling."
        },
        {
          "local_term": "Afdeling",
          "akn_element": "section",
          "level": "higher",
          "bluebell_keyword": "SECTION",
          "numbering": "arabic_continuous",
          "note": "Groups artikelen within a Hoofdstuk or Titel. NOTE: AKN section used here as a higher division container, not as the basic unit."
        },
        {
          "local_term": "Paragraaf",
          "akn_element": "subsection",
          "level": "higher",
          "bluebell_keyword": "SUBSECTION",
          "numbering": "arabic_with_symbol",
          "note": "Structural Paragraaf (§ 1, § 2) is a higher division below Afdeling. NOT a subdivision of artikel. Post-processing may be needed to correctly represent in AKN."
        },
        {
          "local_term": "Artikel",
          "akn_element": "article",
          "level": "basic",
          "bluebell_keyword": "ARTICLE",
          "numbering": "arabic_continuous",
          "note": "The fundamental citable provision. Basic unit of Dutch legislation."
        },
        {
          "local_term": "Lid",
          "akn_element": "paragraph",
          "level": "subdivision",
          "bluebell_keyword": "PARAGRAPH",
          "numbering": "arabic",
          "note": "Subdivision of artikel. Cited as 'artikel 5, eerste lid'. Arabic numerals (1, 2, 3)."
        },
        {
          "local_term": "Onderdeel",
          "akn_element": "point",
          "level": "subdivision",
          "bluebell_keyword": "POINT",
          "numbering": "alpha_lower",
          "note": "List item within a lid. Lowercase letters (a, b, c). Cited as 'onderdeel a' or 'onder a'."
        },
        {
          "local_term": "Sub-onderdeel",
          "akn_element": "indent",
          "level": "subdivision",
          "bluebell_keyword": "INDENT",
          "numbering": "numeric_degree",
          "note": "Further subdivision of onderdeel (1°, 2°). Rare."
        }
      ],
      "hcontainers": [],
      "note": "Jurisdiction-specific Bluebell prompt required (structure_nl.txt). ARTICLE is the basic unit, not SECTION."
    },
