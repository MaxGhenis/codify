{
  "code": "ar",
  "name": "Argentina",
  "type": "national",
  "tradition": [
    "civil_law"
  ],
  "calendar": "gregorian",
  "languages": [
    "spa"
  ],
  "authoritative_language": "spa",
  "document_classes": {
    "ley": {
      "label": "Ley Nacional",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "article",
      "hierarchy": [
        {
          "local_term": "Libro",
          "akn_element": "book",
          "level": "higher",
          "bluebell_keyword": "BOOK",
          "numbering": "ordinal_word",
          "note": "Codes only (Código Civil y Comercial, etc.). Format: LIBRO PRIMERO."
        },
        {
          "local_term": "Título",
          "akn_element": "title",
          "level": "higher",
          "bluebell_keyword": "TITLE",
          "numbering": "roman_or_ordinal_word",
          "note": "Present in codes and complex laws. Format: TÍTULO I, TÍTULO PRELIMINAR."
        },
        {
          "local_term": "Capítulo",
          "akn_element": "chapter",
          "level": "higher",
          "bluebell_keyword": "CHAPTER",
          "numbering": "roman",
          "note": "Most common higher division in ordinary laws. Format: CAPÍTULO I."
        },
        {
          "local_term": "Sección",
          "akn_element": "section",
          "level": "higher",
          "bluebell_keyword": "SUBDIVISION",
          "numbering": "ordinal_word",
          "note": "Grouping above artículos in codes only. Always a higher division, never the basic unit. Format: Sección 1ª."
        },
        {
          "local_term": "Artículo",
          "akn_element": "article",
          "level": "basic",
          "bluebell_keyword": "ARTICLE",
          "numbering": "arabic_degree",
          "note": "Basic citable unit. Format: Art. 1°.– or Artículo 1°.– Numbered continuously throughout law."
        },
        {
          "local_term": "Inciso",
          "akn_element": "paragraph",
          "level": "subdivision",
          "bluebell_keyword": "PARAGRAPH",
          "numbering": "alpha_lower_parenthesized",
          "note": "First-level subdivision within artículo. Format: a), b), c). Cited as 'inciso a)'."
        },
        {
          "local_term": "Punto / Sub-inciso",
          "akn_element": "point",
          "level": "subdivision",
          "bluebell_keyword": "POINT",
          "numbering": "arabic_period",
          "note": "Second-level subdivision within inciso. Format: 1., 2., 3. Used in technical and commercial legislation."
        }
      ],
      "hcontainers": [
        {
          "name": "tituloPreliminar",
          "local_term": "Título Preliminar",
          "note": "Preliminary Title in codes; precedes main Book/Title hierarchy. eId: hcontainer_1."
        }
      ]
    },
    "dnu": {
      "label": "Decreto de Necesidad y Urgencia",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "article",
      "hierarchy": [
        {
          "local_term": "Artículo",
          "akn_element": "article",
          "level": "basic",
          "bluebell_keyword": "ARTICLE",
          "numbering": "arabic_degree"
        },
        {
          "local_term": "Inciso",
          "akn_element": "paragraph",
          "level": "subdivision",
          "bluebell_keyword": "PARAGRAPH",
          "numbering": "alpha_lower_parenthesized"
        }
      ],
      "hcontainers": [],
      "note": "DNUs have the force of law but are issued by the Executive under Art. 99(3) CN. Use subtype 'dnu' in FRBR URI."
    },
    "decreto": {
      "label": "Decreto Reglamentario",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "article",
      "hierarchy": [
        {
          "local_term": "Artículo",
          "akn_element": "article",
          "level": "basic",
          "bluebell_keyword": "ARTICLE",
          "numbering": "arabic_degree"
        },
        {
          "local_term": "Inciso",
          "akn_element": "paragraph",
          "level": "subdivision",
          "bluebell_keyword": "PARAGRAPH",
          "numbering": "alpha_lower_parenthesized"
        }
      ],
      "hcontainers": [],
      "note": "Regulatory decrees implementing laws. Numbered annually: Decreto N° 984/2024."
    },
    "constitucion": {
      "label": "Constitución de la Nación Argentina",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "article",
      "hierarchy": [
        {
          "local_term": "Parte",
          "akn_element": "part",
          "level": "higher",
          "bluebell_keyword": "PART",
          "numbering": "ordinal_word",
          "note": "Primera Parte, Segunda Parte."
        },
        {
          "local_term": "Título",
          "akn_element": "title",
          "level": "higher",
          "bluebell_keyword": "TITLE",
          "numbering": "ordinal_word"
        },
        {
          "local_term": "Sección",
          "akn_element": "chapter",
          "level": "higher",
          "bluebell_keyword": "CHAPTER",
          "numbering": "ordinal_word",
          "note": "The Constitution uses 'Sección' where other laws use 'Capítulo'. Maps to chapter for AKN purposes."
        },
        {
          "local_term": "Capítulo",
          "akn_element": "section",
          "level": "higher",
          "bluebell_keyword": "SUBDIVISION",
          "numbering": "ordinal_word",
          "note": "Within a constitutional Sección, Capítulos group articles."
        },
        {
          "local_term": "Artículo",
          "akn_element": "article",
          "level": "basic",
          "bluebell_keyword": "ARTICLE",
          "numbering": "arabic_continuous"
        }
      ],
      "hcontainers": [],
      "note": "The 1853 Constitution reinstated 1983, amended 1994. Work URI uses 1853 date. Articles numbered continuously 1–129."
    }
  },
  "default_document_class": "ley",
  "frbr": {
    "country_code": "ar",
    "uri_patterns": {
      "ley": "/akn/ar/act/{year}/{number}",
      "dnu": "/akn/ar/act/dnu/{year}/{number}",
      "decreto": "/akn/ar/act/decreto/{year}/{number}",
      "constitucion": "/akn/ar/act/constitucion/1853/constitucion"
    },
    "number_format": "bare_integer",
    "number_note": "Strip thousands-separator periods from Argentine citation format (Ley 26.994 → 26994 in URI). Display layer re-adds separator.",
    "date_calendar": "gregorian"
  },
  "numbering": {
    "insertion_style": "bis_ter_quater",
    "insertion_note": "Inserted articles use Latin ordinal suffixes: Artículo 5° bis, Artículo 12 ter, Artículo 8 quater."
  },
  "amendments": {
