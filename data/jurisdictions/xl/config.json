  "structuring": {
    "prompt_variant": "structure_civil.txt",
    "prompt_additions": "The hierarchy inverts the European convention: Bab (Chapter) > Bagian (Part/Section) > Paragraf > Pasal (Article). Use CHAPTER > PART > DIVISION > ARTICLE. Pasal carry no heading of their own. Bagian are numbered with Bahasa ordinal words (Bagian Kesatu, Bagian Ketujuh); Bab use Roman numerals; Paragraf and Pasal use Arabic. Batang tubuh order is Ketentuan Umum, then the substantive chapters, then Ketentuan Peralihan and Ketentuan Penutup last.",
    "reference_nouns": ["Pasal", "ayat", "huruf", "angka"],
    "ordinal_words": {
      "Kesatu": 1,
      "Kedua": 2,
      "Ketiga": 3,
      "Keempat": 4,
      "Kelima": 5,
      "Keenam": 6,
      "Ketujuh": 7,
      "Kedelapan": 8,
      "Kesembilan": 9,
      "Kesepuluh": 10,
      "Kesebelas": 11,
      "Kedua Belas": 12,
      "Ketiga Belas": 13,
      "Keempat Belas": 14,
      "Kelima Belas": 15,
      "Keenam Belas": 16,
      "Ketujuh Belas": 17,
      "Kedelapan Belas": 18,
      "Kesembilan Belas": 19,
      "Kedua Puluh": 20
    },
    "marker_boundary": "line_anchored",
    "body_opens_with_container": true,
    "prose_precursors": ["dan", "atau", "dalam", "pada", "ketentuan", "juga", "ayat", "huruf", "angka"],
    "sameline_precursors": ["Mengingat", "Menimbang", "sebagaimana dimaksud dalam"],
    "marker_tolerances": ["missing_separator", "keyword_glyph", "digit_glyph", "split_number"],
    "example_markers": ["Contoh"],
    "classification_rules": [
      {
        "signal": "title_regex",
        "pattern": "^\\s*IKHTISAR\\s+PUTUSAN\\b",
        "pattern_flags": "i",
        "target_document_class": "ikhtisar",
        "priority": 110
      },
      {
        "signal": "title_regex",
        "pattern": "^\\s*PUTUSAN\\b",
        "pattern_flags": "i",
        "target_document_class": "putusan",
        "priority": 105
      },
      {
        "signal": "title_regex",
        "pattern": "PERATURAN\\s+DAERAH\\s+PROVINSI",
        "pattern_flags": "i",
        "target_document_class": "perda_provinsi",
        "priority": 95
      },
