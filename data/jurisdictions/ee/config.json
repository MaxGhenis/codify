  "document_classes": {
    "act": {
      "label": "Seadus (Act of the Riigikogu)",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "article",
      "hierarchy": [
        {
          "local_term": "Osa",
          "akn_element": "part",
          "level": "higher",
          "bluebell_keyword": "PART",
          "numbering": "arabic_period",
          "note": "Highest division in large codes; '1. osa', '2. osa'. Not present in short acts."
        },
        {
          "local_term": "Peatükk",
          "akn_element": "chapter",
          "level": "higher",
          "bluebell_keyword": "CHAPTER",
          "numbering": "arabic_period",
          "note": "Primary grouping in most acts; '1. peatükk', '2. peatükk'"
        },
        {
          "local_term": "Jagu",
          "akn_element": "section",
          "level": "higher",
          "bluebell_keyword": "SECTION",
          "numbering": "arabic_period",
          "note": "Division below peatükk; '1. jagu'. Used in complex codes only. Maps to AKN section-as-higher-div."
        },
        {
          "local_term": "Alljaotus / Alajagu",
          "akn_element": "subsection",
          "level": "higher",
          "bluebell_keyword": "SUBSECTION",
          "numbering": "arabic_period",
          "note": "Rare; subdivision of jagu in the most complex codes."
        },
        {
          "local_term": "§ (Paragrahv)",
          "akn_element": "article",
          "level": "basic",
          "bluebell_keyword": "ARTICLE",
          "numbering": "arabic_continuous",
          "note": "Basic citable unit. Cited as '§ 5'. Continuous without restart per chapter. Insertion: § 51, § 52 (superscript in display)."
        },
        {
          "local_term": "Lõige",
          "akn_element": "paragraph",
          "level": "subdivision",
          "bluebell_keyword": "PARAGRAPH",
          "numbering": "arabic_parenthesized",
          "note": "Subdivisions of §. (1), (2), (3). Cited as '§ 5 lõige 1' or '§ 5 lg 1'."
        },
        {
          "local_term": "Punkt",
          "akn_element": "point",
          "level": "subdivision",
          "bluebell_keyword": "POINT",
          "numbering": "arabic_closing_paren",
          "note": "Numbered items within lõige. 1), 2), 3). Cited as 'punkt 1' or 'p 1'."
        },
        {
          "local_term": "Alapunkt",
          "akn_element": "indent",
          "level": "subdivision",
          "bluebell_keyword": "INDENT",
          "numbering": "alpha_lower_closing_paren",
          "note": "Lettered sub-items within punkt. a), b), c). Cited as 'alapunkt a'."
        }
      ],
      "hcontainers": [],
      "note": "Estonian § (paragrahv) maps to AKN article per German-tradition convention (same as LegalDocML.de). Jagu maps to AKN section used as a higher division, not the basic unit."
    },
    "constitution": {
      "label": "Põhiseadus (Constitution)",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "article",
      "hierarchy": [
        {
          "local_term": "Jagu (Constitutional chapter)",
          "akn_element": "chapter",
          "level": "higher",
          "bluebell_keyword": "CHAPTER",
          "numbering": "roman",
          "note": "The Constitution uses 'jagu' (I–XV) where ordinary acts use 'peatükk'. Map to chapter here."
        },
        {
          "local_term": "§ (Paragrahv)",
          "akn_element": "article",
          "level": "basic",
          "bluebell_keyword": "ARTICLE",
          "numbering": "arabic_continuous",
          "note": "§ 1 through § 168, continuous without restart per chapter."
        },
        {
          "local_term": "Lõige",
          "akn_element": "paragraph",
          "level": "subdivision",
          "bluebell_keyword": "PARAGRAPH",
          "numbering": "arabic_parenthesized"
        },
        {
          "local_term": "Punkt",
          "akn_element": "point",
          "level": "subdivision",
          "bluebell_keyword": "POINT",
          "numbering": "arabic_closing_paren"
        }
      ],
      "hcontainers": [],
      "note": "Constitution uses 'jagu' (Roman-numbered) at the top level instead of 'peatükk'. Map to chapter. No osa or peatükk present."
    },
    "maarrus": {
      "label": "Määrus (Government or Ministerial Regulation)",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "article",
      "hierarchy": [
        {
          "local_term": "Peatükk",
          "akn_element": "chapter",
          "level": "higher",
          "bluebell_keyword": "CHAPTER",
          "numbering": "arabic_period"
        },
        {
          "local_term": "§ (Paragrahv)",
          "akn_element": "article",
          "level": "basic",
          "bluebell_keyword": "ARTICLE",
          "numbering": "arabic_continuous"
        },
        {
          "local_term": "Lõige",
          "akn_element": "paragraph",
          "level": "subdivision",
          "bluebell_keyword": "PARAGRAPH",
          "numbering": "arabic_parenthesized"
        },
        {
          "local_term": "Punkt",
          "akn_element": "point",
          "level": "subdivision",
          "bluebell_keyword": "POINT",
          "numbering": "arabic_closing_paren"
        },
        {
          "local_term": "Alapunkt",
          "akn_element": "indent",
          "level": "subdivision",
          "bluebell_keyword": "INDENT",
          "numbering": "alpha_lower_closing_paren"
        }
      ],
      "hcontainers": [],
      "note": "Government and ministerial regulations follow the same § convention. Issued under enabling provisions of parent acts."
    }
  },
