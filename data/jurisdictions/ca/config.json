{
  "code": "ca",
  "name": "Canada",
  "type": "national",
  "tradition": [
    "common_law",
    "civil_law"
  ],
  "calendar": "gregorian",
  "languages": [
    "eng",
    "fra"
  ],
  "authoritative_language": null,
  "document_classes": {
    "act": {
      "label": "Act of Parliament",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "section",
      "hierarchy": [
        {
          "local_term": "Part",
          "akn_element": "part",
          "level": "higher",
          "bluebell_keyword": "PART",
          "numbering": "arabic_continuous",
          "note": "Some older Acts use Roman numerals; normalise to Arabic in eId"
        },
        {
          "local_term": "Section",
          "akn_element": "section",
          "level": "basic",
          "bluebell_keyword": "SECTION",
          "numbering": "arabic_continuous"
        },
        {
          "local_term": "Subsection",
          "akn_element": "subsection",
          "level": "subdivision",
          "bluebell_keyword": "SUBSECTION",
          "numbering": "arabic_parenthesized"
        },
        {
          "local_term": "Paragraph",
          "akn_element": "paragraph",
          "level": "subdivision",
          "bluebell_keyword": "PARAGRAPH",
          "numbering": "alpha_lower_italic_parenthesized"
        },
        {
          "local_term": "Subparagraph",
          "akn_element": "subparagraph",
          "level": "subdivision",
          "bluebell_keyword": "SUBPARAGRAPH",
          "numbering": "roman_lower_parenthesized"
        },
        {
          "local_term": "Clause",
          "akn_element": "point",
          "level": "subdivision",
          "bluebell_keyword": "POINT",
          "numbering": "alpha_upper_parenthesized",
          "note": "Uppercase letters (A),(B),(C). Rare; used in Income Tax Act and complex fiscal legislation."
        }
      ],
      "hcontainers": [
        {
          "local_term": "Division",
          "name": "division",
          "level": "higher",
          "note": "Used in Income Tax Act only. No Bluebell keyword — requires post-processing. PART > DIVISION > SUBDIVISION > SECTION."
        },
        {
          "local_term": "Subdivision",
          "name": "subdivision",
          "level": "higher",
          "note": "Used in Income Tax Act only. Nested under Division. Requires post-processing."
        }
      ]
    },
    "regulation": {
      "label": "Regulation (Statutory Orders and Regulations)",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "section",
      "hierarchy": [
        {
          "local_term": "Part",
          "akn_element": "part",
          "level": "higher",
          "bluebell_keyword": "PART",
          "numbering": "arabic_continuous"
        },
        {
          "local_term": "Section",
          "akn_element": "section",
          "level": "basic",
          "bluebell_keyword": "SECTION",
          "numbering": "arabic_continuous"
        },
        {
          "local_term": "Subsection",
          "akn_element": "subsection",
          "level": "subdivision",
          "bluebell_keyword": "SUBSECTION",
          "numbering": "arabic_parenthesized"
        },
        {
          "local_term": "Paragraph",
          "akn_element": "paragraph",
          "level": "subdivision",
          "bluebell_keyword": "PARAGRAPH",
          "numbering": "alpha_lower_italic_parenthesized"
        },
        {
          "local_term": "Subparagraph",
          "akn_element": "subparagraph",
          "level": "subdivision",
          "bluebell_keyword": "SUBPARAGRAPH",
          "numbering": "roman_lower_parenthesized"
        }
      ],
      "hcontainers": [],
      "note": "Federal regulations use 'section' as basic unit, not 'regulation'. SOR/YYYY-NNN citation format."
    },
    "constitution": {
      "label": "Constitution Act",
      "akn_element": "act",
      "bluebell_compatible": true,
      "basic_unit": "section",
      "hierarchy": [
        {
          "local_term": "Part",
          "akn_element": "part",
          "level": "higher",
          "bluebell_keyword": "PART",
          "numbering": "roman"
        },
        {
          "local_term": "Section",
          "akn_element": "section",
          "level": "basic",
          "bluebell_keyword": "SECTION",
          "numbering": "arabic_continuous"
        },
        {
          "local_term": "Subsection",
          "akn_element": "subsection",
          "level": "subdivision",
          "bluebell_keyword": "SUBSECTION",
          "numbering": "arabic_parenthesized"
        },
        {
          "local_term": "Paragraph",
          "akn_element": "paragraph",
          "level": "subdivision",
          "bluebell_keyword": "PARAGRAPH",
          "numbering": "alpha_lower_italic_parenthesized"
        }
      ],
      "hcontainers": [],
      "note": "Constitution Acts 1867 and 1982 use PART > SECTION. Charter sections are numbered continuously within Part I."
    }
  },
  "default_document_class": "act",
  "bilingual": {
    "enabled": true,
    "languages": [
      "eng",
      "fra"
    ],
    "strategy": "parallel_originals",
    "frbr_note": "Both English and French versions are co-equal originals (not translations). Each is a separate FRBR expression of the same Work. Do NOT use FRBRtranslation. Statutory authority: Interpretation Act RSC 1985 c. I-21 s. 8; Canadian Charter s. 18.",
    "processing_note": "Pipeline must process both language versions as paired inputs, producing two AKN XML files linked by the same FRBR Work URI."
  },
  "frbr": {
    "country_code": "ca",
    "uri_patterns": {
      "regulation_sor": "/akn/ca/act/sor/{year}/{number}",
      "regulation_si": "/akn/ca/act/si/{year}/{number}"
    },
    "sample_uris": {
      "Criminal Code (RSC 1985, c. C-46)": "/akn/ca/act/1985/c-46",
      "Income Tax Act (RSC 1985, c. 1 (5th Supp.))": "/akn/ca/act/1985/i-3.3",
      "Budget Implementation Act, 2024, No. 1 (SC 2024, c. 17)": "/akn/ca/act/2024/17",
      "SIN Regulations (SOR/2013-82)": "/akn/ca/act/sor/2013/82",
      "Constitution Act, 1867": "/akn/ca/act/constitution/1867/constitution-act",
      "Constitution Act, 1982": "/akn/ca/act/constitution/1982/constitution-act",
      "Bill C-69, 44th Parliament 1st Session": "/akn/ca/bill/44-1/c-69"
    },
    "date_calendar": "gregorian",
    "uri_construction_notes": [
      "RSC 1985 Acts: use lowercased alphanumeric chapter code as number segment (e.g. 'c-46' for c. C-46)",
      "RSC 1985 Supplement Acts: use Justice Canada's URL slug as number segment (e.g. 'i-3.3' for ITA)",
      "Annual Statutes (SC): use enactment year and chapter number (e.g. 2024/17 for SC 2024 c. 17)",
      "SOR Regulations: use year and sequential number (e.g. sor/2013/82 for SOR/2013-82)",
      "Bills: use parliament-session and bill identifier (e.g. 44-1/c-69 for Bill C-69, 44-1)"
    ]
  },
  "numbering": {
    "act_citation_rsc": "RSC 1985, c. {letter}-{number}",
    "act_citation_sc": "SC {year}, c. {chapter}",
    "regulation_citation": "SOR/{year}-{number}",
    "si_citation": "SI/{year}-{number}",
    "pc_citation": "PC {year}-{number}",
    "crc_citation": "CRC, c. {chapter}",
    "insertion_style": "decimal",
    "insertion_note": "Federal legislation uses decimal insertion (5.1, 5.2) between existing sections. Lettered insertion (5A) occasionally seen in older statutes."
  },
  "enacting_formulae": [
    {
      "language": "eng",
      "text": "His Majesty, by and with the advice and consent of the Senate and House of Commons of Canada, enacts as follows:",
