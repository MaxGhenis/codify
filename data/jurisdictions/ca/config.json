      "to": "2022-09-08",
      "note": "During Queen Elizabeth II's reign",
      "document_class": "act"
    }
  ],
  "amendments": {
    "style": "textual_commonwealth",
    "phrasing_patterns": [
      "Section [N] of the [Act] is replaced by the following:",
      "is amended by striking out '[old text]' and substituting '[new text]'",
      "is amended by adding the following after [section N]:",
      "Section [N] of the [Act] is repealed.",
      "Paragraph [N](1)(a) of the [Act] is replaced by the following:"
