  "default_document_class": "act",
  "frbr": {
    "country_code": "np",
    "uri_patterns": {
      "act": "/akn/np/act/{year}/{number}",
      "ordinance": "/akn/np/act/ordinance/{year}/{number}",
      "rules": "/akn/np/act/rules/{year}/{number}",
      "bill": "/akn/np/bill/{year}/{number}",
      "constitution": "/akn/np/act/constitution/2015/constitution",
      "samhita": "/akn/np/act/samhita/{year}/{number}"
    },
    "date_calendar": "gregorian",
    "date_calendar_note": "Nepal uses Bikram Samvat (B.S.) as official calendar — B.S. 2072 = 2015 CE. FRBR URIs always use Gregorian year. B.S. date stored as FRBRalias. Conversion: B.S. year - 56 or 57 = CE year (month-dependent; Nepali New Year falls in mid-April CE). Pipeline must convert B.S. dates at ingestion time.",
    "calendar_conversion": {
      "kind": "bikram_samvat",
      "offset": 57,
      "new_year_month": 4,
      "new_year_day": 14,
      "note": "Bikram Samvat (BS). Nepali New Year falls ~14 April. BS year is 56-57 years ahead of Gregorian. Before mid-April, subtract 57; after, subtract 57 then add 1. FRBR URIs always use Gregorian; BS date stored as FRBRalias."
    }
  },
