          "akn_element": "subparagraph",
          "level": "subdivision",
          "bluebell_keyword": "SUBPARAGRAPH",
          "numbering": "roman_lower_parenthesized"
        }
      ],
      "hcontainers": [
        {
          "local_term": "Tara",
          "name": "proviso",
          "description": "Proviso-style clause ('Provided that…'), inherited from British-India drafting convention via Indian legal influence. Uses native Bluebell PROVISO keyword.",
          "bluebell_proxy": "PROVISO",
          "requires_postprocessing": false
        },
        {
          "local_term": "Spashtikaran",
          "name": "explanation",
          "description": "Explanatory note within a Daphaa, analogous to Indian 'Explanation'. Clarificatory, does not create new rights.",
          "bluebell_proxy": "SUBSECTION",
          "requires_postprocessing": true
        },
        {
          "local_term": "Anusuchi",
          "name": "schedule",
          "description": "Schedule or annexure appended to an Act.",
          "bluebell_proxy": "SUBSECTION",
          "requires_postprocessing": true
        }
      ],
      "note": "Primary document class. Parichched (chapter) is the main grouping unit; Daphaa is the basic citable section. English translations use 'Section' for Daphaa."
    },
